diff --git a/crates/grammars/src/objc/config.toml b/crates/grammars/src/objc/config.toml
new file mode 100644
index 0000000..c2aa7c9
--- /dev/null
+++ b/crates/grammars/src/objc/config.toml
@@ -0,0 +1,20 @@
+name = "Objective-C"
+grammar = "objc"
+path_suffixes = ["mm", "m", "hh", "h"]
+line_comments = ["// "]
+brackets = [
+    { start = "{", end = "}", close = true, newline = true },
+    { start = "[", end = "]", close = true, newline = true },
+    { start = "(", end = ")", close = true, newline = false },
+    { start = "\"", end = "\"", close = true, newline = false, not_in = [
+        "string",
+    ] },
+    { start = "'", end = "'", close = true, newline = false, not_in = [
+        "string",
+        "comment",
+    ] },
+    { start = "/*", end = "*/", close = true, newline = false, not_in = [
+        "string",
+        "comment",
+    ] },
+]

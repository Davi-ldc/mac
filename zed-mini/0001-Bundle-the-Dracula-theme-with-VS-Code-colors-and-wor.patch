 crates/settings_content/src/theme.rs |   21 +
 crates/theme/src/default_colors.rs   |   14 +
 crates/theme/src/fallback_themes.rs  |    7 +
 crates/theme/src/styles/colors.rs    |   15 +
 crates/theme_settings/src/schema.rs  |   28 +
 7 files changed, 1365 insertions(+)
 create mode 100644 assets/themes/dracula/LICENSE
 create mode 100644 assets/themes/dracula/dracula.json


 1 file changed, 98 insertions(+), 14 deletions(-)

diff --git a/crates/gpui_apple/src/metal_renderer.rs b/crates/gpui_apple/src/metal_renderer.rs
index 7b3e4a6..d73cf19 100644
--- a/crates/gpui_apple/src/metal_renderer.rs
+++ b/crates/gpui_apple/src/metal_renderer.rs
@@ -54,6 +54,81 @@ fn diag_path_sample_count() -> u32 {
     *COUNT
 }
 
+fn diag_flag(name: &str) -> bool {
+    std::env::var_os(name).is_some()
+}
+
+fn diag_no_inline_bytes() -> bool {
+    static FLAG: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| diag_flag("MINI_DIAG_NO_INLINE_BYTES"));
+    *FLAG
+}
+
+/// Small uniforms normally go through Metal's inline-bytes calls; the switch binds them
+/// from a tiny buffer instead, to see whether those calls own the 8 MB GPU blocks.
+trait DiagInlineBytes {
+    unsafe fn diag_set_vertex_bytes(
+        &self,
+        bytes: ptr::NonNull<std::ffi::c_void>,
+        length: usize,
+        index: usize,
+    );
+    unsafe fn diag_set_fragment_bytes(
+        &self,
+        bytes: ptr::NonNull<std::ffi::c_void>,
+        length: usize,
+        index: usize,
+    );
+}
+
+impl DiagInlineBytes for ProtocolObject<dyn MTLRenderCommandEncoder> {
+    unsafe fn diag_set_vertex_bytes(
+        &self,
+        bytes: ptr::NonNull<std::ffi::c_void>,
+        length: usize,
+        index: usize,
+    ) {
+        unsafe {
+            if diag_no_inline_bytes() {
+                let buffer = self
+                    .device()
+                    .newBufferWithBytes_length_options(
+                        bytes,
+                        length,
+                        MTLResourceOptions::StorageModeShared,
+                    )
+                    .expect("diagnostic uniform buffer");
+                self.setVertexBuffer_offset_atIndex(Some(&buffer), 0, index);
+            } else {
+                self.setVertexBytes_length_atIndex(bytes, length, index);
+            }
+        }
+    }
+
+    unsafe fn diag_set_fragment_bytes(
+        &self,
+        bytes: ptr::NonNull<std::ffi::c_void>,
+        length: usize,
+        index: usize,
+    ) {
+        unsafe {
+            if diag_no_inline_bytes() {
+                let buffer = self
+                    .device()
+                    .newBufferWithBytes_length_options(
+                        bytes,
+                        length,
+                        MTLResourceOptions::StorageModeShared,
+                    )
+                    .expect("diagnostic uniform buffer");
+                self.setFragmentBuffer_offset_atIndex(Some(&buffer), 0, index);
+            } else {
+                self.setFragmentBytes_length_atIndex(bytes, length, index);
+            }
+        }
+    }
+}
+
 fn diag_no_paths() -> bool {
     static NO_PATHS: std::sync::LazyLock<bool> =
         std::sync::LazyLock::new(|| std::env::var_os("MINI_DIAG_NO_PATHS").is_some());
@@ -113,7 +188,9 @@ impl InstanceBufferPool {
         if let Some(buffer) = self.buffers.pop() {
             return Ok(buffer);
         }
-        let options = if unified_memory {
+        let options = if unified_memory && diag_flag("MINI_DIAG_NO_WRITE_COMBINED") {
+            MTLResourceOptions::StorageModeShared
+        } else if unified_memory {
             MTLResourceOptions::StorageModeShared
                 // Buffers are write only which can benefit from the combined cache
                 // https://developer.apple.com/documentation/metal/mtlresourceoptions/cpucachemodewritecombined
@@ -415,7 +492,14 @@ impl MetalRenderer {
             MTLPixelFormat::BGRA8Unorm,

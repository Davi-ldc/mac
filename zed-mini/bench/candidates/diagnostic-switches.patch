-        let command_queue = device.newCommandQueue().context("creating command queue")?;
+        let command_queue = match std::env::var("MINI_DIAG_QUEUE_MAX")
+            .ok()
+            .and_then(|count| count.parse().ok())
+        {
+            Some(count) => device.newCommandQueueWithMaxCommandBufferCount(count),
+            None => device.newCommandQueue(),
+        }
+        .context("creating command queue")?;
         let supports_shared_storage = cfg!(target_os = "ios") || is_apple_gpu;

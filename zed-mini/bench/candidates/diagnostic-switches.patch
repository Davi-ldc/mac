From f9a37ff5c5126d4222a677f6889c3124c40123cb Mon Sep 17 00:00:00 2001
From: mini <mini@local>
Date: Sun, 22 Nov 2026 15:00:03 -0300
Subject: [PATCH 1/2] DIAGNOSTIC (not in the series): env switches for path
 multisampling and path drawing, and a log line per path batch

---
 crates/gpui_apple/src/metal_renderer.rs | 33 ++++++++++++++++++++++---
 1 file changed, 30 insertions(+), 3 deletions(-)

diff --git a/crates/gpui_apple/src/metal_renderer.rs b/crates/gpui_apple/src/metal_renderer.rs
index 1db6000..7b3e4a6 100644
--- a/crates/gpui_apple/src/metal_renderer.rs
+++ b/crates/gpui_apple/src/metal_renderer.rs
@@ -43,6 +43,22 @@ const SHADERS_SOURCE_FILE: &str = include_str!(concat!(env!("OUT_DIR"), "/stitch
 // Use 4x MSAA, all devices support it.
 // https://developer.apple.com/documentation/metal/mtldevice/1433355-supportstexturesamplecount
 const PATH_SAMPLE_COUNT: u32 = 4;
+
+fn diag_path_sample_count() -> u32 {
+    static COUNT: std::sync::LazyLock<u32> = std::sync::LazyLock::new(|| {
+        std::env::var("MINI_DIAG_PATH_SAMPLES")
+            .ok()
+            .and_then(|count| count.parse().ok())
+            .unwrap_or(PATH_SAMPLE_COUNT)
+    });
+    *COUNT
+}
+
+fn diag_no_paths() -> bool {
+    static NO_PATHS: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var_os("MINI_DIAG_NO_PATHS").is_some());
+    *NO_PATHS
+}
 /// The path textures are as large as the area the frame's paths cover, rounded up to this
 /// many pixels so that a highlight growing by a few pixels does not reallocate them.
 const PATH_TEXTURE_GRANULARITY: i32 = 256;
@@ -340,7 +356,7 @@ impl MetalRenderer {
             "path_rasterization_vertex",
             "path_rasterization_fragment",
             MTLPixelFormat::BGRA8Unorm,
-            PATH_SAMPLE_COUNT,
+            diag_path_sample_count(),
         )?;
         let path_sprites_pipeline_state = build_path_sprite_pipeline_state(
             &device,
@@ -442,7 +458,7 @@ impl MetalRenderer {
             core_video_texture_cache,
             path_intermediate_texture: None,
             path_intermediate_msaa_texture: None,
-            path_sample_count: PATH_SAMPLE_COUNT,
+            path_sample_count: diag_path_sample_count(),
             #[cfg(any(test, feature = "bench-support", feature = "test-support"))]
             headless_render_target: None,
         })
@@ -888,6 +904,17 @@ impl MetalRenderer {
                     let Some(region) = path_batch_region(paths, viewport_size) else {
                         continue;
                     };
+                    if diag_no_paths() {
+                        continue;
+                    }
+                    log::info!(
+                        "DIAG path batch: {} paths, region {}x{} at {},{}",
+                        paths.len(),
+                        region.size.width.0,
+                        region.size.height.0,
+                        region.origin.x.0,
+                        region.origin.y.0
+                    );
                     command_encoder.endEncoding();
 
                     self.draw_paths_to_intermediate(paths, region, writer, &command_buffer)?;
@@ -1951,7 +1978,7 @@ fn path_texture_size(
     scene: &Scene,
     viewport_size: Size<DevicePixels>,
 ) -> Option<Size<DevicePixels>> {
-    if scene.paths.is_empty() {
+    if scene.paths.is_empty() || diag_no_paths() {
         return None;
     }
     let mut largest: Option<(i32, i32)> = None;

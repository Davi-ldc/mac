+        if tx.unbounded_send(initial_contents.clone()).is_err() {
+            return;
+        }
+
         let (events, _) = fs.watch(&path, Duration::from_millis(100)).await;
         futures::pin_mut!(events);
 
-        let contents = fs.load(&path).await.unwrap_or_default();
-        if tx.unbounded_send(contents).is_err() {
+        // Re-check once after arming the watcher so writes between the initial read
+        // and watcher setup are never missed.
+        if let Ok(contents) = fs.load(&path).await
+            && contents != initial_contents
+            && tx.unbounded_send(contents).is_err()
+        {
             return;
         }
 

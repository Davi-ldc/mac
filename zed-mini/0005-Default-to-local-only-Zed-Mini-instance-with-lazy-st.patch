@@ -143,12 +143,40 @@ util::fs_embed! {
     exclude = ["*.DS_Store"],
 }
 
+pub struct PreloadedDefaultSettings {
+    default_settings: SettingsContent,
+    semantic_token_rules: SemanticTokenRules,
+}
+
+pub fn preload_default_settings() -> PreloadedDefaultSettings {
+    let default_settings = SettingsStore::parse_default_settings(&default_settings())
+        .expect("failed to parse bundled default settings");
+    let semantic_token_rules =
+        crate::parse_json_with_comments::<SemanticTokenRules>(&default_semantic_token_rules())
+            .unwrap_or_default();
+    PreloadedDefaultSettings {
+        default_settings,
+        semantic_token_rules,
+    }
+}
+
 pub fn init(cx: &mut App) {
     let settings = SettingsStore::new(cx, &default_settings());
     cx.set_global(settings);
     SettingsStore::observe_active_settings_profile_name(cx).detach();
 }
 
+pub fn init_with_preloaded(preloaded: PreloadedDefaultSettings, cx: &mut App) {
+    if !cx.has_global::<DefaultSemanticTokenRules>() {
+        cx.set_global::<DefaultSemanticTokenRules>(DefaultSemanticTokenRules(
+            preloaded.semantic_token_rules,
+        ));
+    }
+    let settings = SettingsStore::from_preloaded_default_settings(cx, preloaded.default_settings);
+    cx.set_global(settings);
+    SettingsStore::observe_active_settings_profile_name(cx).detach();
+}
+
 pub fn default_settings() -> Cow<'static, str> {
     asset_str::<SettingsAssets>("settings/default.json")
 }

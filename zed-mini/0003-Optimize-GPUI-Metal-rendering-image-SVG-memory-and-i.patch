+++ b/crates/gpui/src/app.rs
@@ -2396,6 +2396,39 @@ impl App {
         &self.foreground_executor
     }
 
+    /// Reclaims transient rendering and allocator memory after heavy views
+    /// (such as Markdown previews) close.
+    pub fn reclaim_memory(&mut self) {
+        let mut evicted_atlas = false;
+        for (_, window) in &self.windows {
+            if let Some(window) = window.as_ref()
+                && window
+                    .platform_window
+                    .sprite_atlas()
+                    .evict_monochrome_tiles_if_excess(2)
+            {
+                evicted_atlas = true;
+            }
+        }
+        if evicted_atlas {
+            self.refresh_windows();
+        }
+        if let Ok(mut arena) = self.element_arena.try_borrow_mut() {
+            arena.shrink_to_minimum();
+        }
+        self.event_arena.shrink_to_minimum();
+        #[cfg(target_os = "macos")]
+        {
+            unsafe extern "C" {
+                fn malloc_zone_pressure_relief(zone: *mut std::ffi::c_void, goal: usize) -> usize;
+            }
+            // SAFETY: NULL asks macOS libmalloc to purge empty magazines across all zones.
+            unsafe {
+                malloc_zone_pressure_relief(std::ptr::null_mut(), 0);
+            }
+        }
+    }
+
     /// Returns the foreground work journal for this app's foreground thread.
     /// Apps constructed on the same thread share the stream.
     #[cfg(feature = "profiler")]

+
+/// Loads an image from `source`. `max_width`, in device pixels, limits how wide it is decoded or
+/// rasterized; it keeps its logical size, so it lays out the same.
+pub(crate) fn load_image(
+    source: Resource,
+    max_svg_raster_size: Option<f32>,
+    max_width: Option<u32>,
+    cx: &mut App,
+) -> impl Future<Output = Result<Arc<RenderImage>, ImageCacheError>> + Send + 'static {
+    let client = cx.http_client();
+    // TODO: Can we make SVGs always rescale?
+    // let scale_factor = cx.scale_factor();
+    let svg_renderer = cx.svg_renderer();
+    let asset_source = cx.asset_source().clone();
+    async move {
+        let bytes: Box<dyn Deref<Target = [u8]> + Send> = match source.clone() {
+            Resource::Path(uri) if max_width.is_some() => {
+                Box::new(TransientBuffer::read_file(uri.as_ref())?)
+            }
+            Resource::Path(uri) => Box::new(fs::read(uri.as_ref())?),
+            Resource::Uri(uri) => {
+                use anyhow::Context as _;
+                use futures::AsyncReadExt as _;
+
+                let mut response = client
+                    .get(uri.as_ref(), ().into(), true)
+                    .await
+                    .with_context(|| format!("loading image asset from {uri:?}"))?;
+                let mut body = Vec::new();
+                response.body_mut().read_to_end(&mut body).await?;
+                if !response.status().is_success() {
+                    let mut body = String::from_utf8_lossy(&body).into_owned();
+                    let first_line = body.lines().next().unwrap_or("").trim_end();
+                    body.truncate(first_line.len());
+                    return Err(ImageCacheError::BadStatus {
+                        uri,
+                        status: response.status(),
+                        body,
+                    });
+                }
+                Box::new(body)
+            }
+            Resource::Embedded(path) => {
+                let data = asset_source.load(&path).ok().flatten();
+                if let Some(data) = data {
+                    Box::new(data.to_vec())
+                } else {
+                    return Err(ImageCacheError::Asset(
+                        format!("Embedded resource not found: {}", path).into(),
+                    ));
+                }
+            }
+        };
+
+        let bytes: &[u8] = &bytes;
+        let result = if let Ok(format) = image::guess_format(bytes) {
+            let still_image = match (format, max_width) {
+                (ImageFormat::Gif | ImageFormat::WebP, _) | (_, None) => None,
+                (_, Some(max_width)) => decode_still_image_at_most_wide(bytes, format, max_width)?,
+            };
+            let image = match still_image {
+                Some(image) => image,
+                None => {
+                    let mut data = match format {
+                        ImageFormat::Gif => decode_gif_image(bytes)?,
+                        ImageFormat::WebP => decode_webp_image(bytes)?,
+                        _ => decode_static_image(bytes, format)?,
+                    };
+                    let shrink =
+                        max_width.map_or(1., |max_width| shrink_to_width(&mut data, max_width));
+                    let mut image = RenderImage::new(data);
+                    image.scale_factor = shrink;
+                    image
+                }
+            };
+
+            Ok(Arc::new(image))
+        } else {
+            match (max_width, max_svg_raster_size) {
+                (Some(max_width), _) => {
+                    svg_renderer.render_single_frame_at_most_wide(bytes, max_width as f32)
+                }
+                (None, Some(max_size)) => svg_renderer.render_single_frame_at_most(bytes, max_size),
+                (None, None) => svg_renderer.render_single_frame(bytes, 1.0),
+            }
+            .map_err(Into::into)
+        };
+        #[cfg(target_os = "macos")]
+        release_malloc_pressure();
+        result
+    }
+}

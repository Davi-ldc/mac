+impl SharedMetalState {
+    fn new() -> Result<Self> {
+        let device = MetalRenderer::create_device()?;
+
+        #[cfg(feature = "runtime_shaders")]
+        let library = device
+            .newLibraryWithSource_options_error(
+                &NSString::from_str(SHADERS_SOURCE_FILE),
+                Some(&objc2_metal::MTLCompileOptions::new()),
+            )
+            .context("building Metal library")?;
+        #[cfg(not(feature = "runtime_shaders"))]
+        let library = device
+            .newLibraryWithData_error(&dispatch2::DispatchData::from_static_bytes(
+                SHADERS_METALLIB,
+            ))
+            .context("loading Metal library")?;
+
+        fn to_float2_bits(point: PointF) -> u64 {
+            let mut output = point.y.to_bits() as u64;
+            output <<= 32;
+            output |= point.x.to_bits() as u64;
+            output
+        }
+
+        // Shared memory can be used only if CPU and GPU share the same memory space.
+        // https://developer.apple.com/documentation/metal/setting-resource-storage-modes
+        // iOS does not support managed resources. Its simulator may report a
+        // non-unified host GPU even though resources must still use shared storage.
+        let is_unified_memory = cfg!(target_os = "ios") || device.hasUnifiedMemory();
+        // Apple GPU families support memoryless textures, which can significantly reduce
+        // memory usage by keeping render targets in on-chip tile memory instead of
+        // allocating backing store in system memory.
+        // https://developer.apple.com/documentation/metal/mtlgpufamily
+        let is_apple_gpu = device.supportsFamily(MTLGPUFamily::Apple1);
+
+        let unit_vertices = [
+            to_float2_bits(point(0., 0.)),
+            to_float2_bits(point(1., 0.)),
+            to_float2_bits(point(0., 1.)),
+            to_float2_bits(point(0., 1.)),
+            to_float2_bits(point(1., 0.)),
+            to_float2_bits(point(1., 1.)),
+        ];
+        // SAFETY: Metal copies the live array using its exact byte length.
+        let unit_vertices = unsafe {
+            device.newBufferWithBytes_length_options(
+                ptr::NonNull::from(&unit_vertices).cast(),
+                mem::size_of_val(&unit_vertices),
+                if is_unified_memory {
+                    MTLResourceOptions::StorageModeShared
+                        | MTLResourceOptions::CPUCacheModeWriteCombined
+                } else {
+                    MTLResourceOptions::StorageModeManaged
+                },
+            )
+        }
+        .context("allocating unit vertex buffer")?;
+
+        let cache_path = metal_archive_cache_path(&device);
+        let archive_state = open_or_create_binary_archive(&device, cache_path.as_deref());
+        let archive_array = archive_state
+            .as_ref()
+            .filter(|(_, loaded_from_disk)| *loaded_from_disk)
+            .map(|(archive, _)| NSArray::from_retained_slice(&[archive.clone()]));
+
+        let mut descriptors = [
+            (
+                "paths_rasterization",
+                make_path_rasterization_pipeline_descriptor(
+                    &library,
+                    "paths_rasterization",
+                    "path_rasterization_vertex",
+                    "path_rasterization_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                    PATH_SAMPLE_COUNT,
+                )?,
+            ),
+            (
+                "path_sprites",
+                make_path_sprite_pipeline_descriptor(
+                    &library,
+                    "path_sprites",
+                    "path_sprite_vertex",
+                    "path_sprite_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                )?,
+            ),
+            (
+                "shadows",
+                make_pipeline_descriptor(
+                    &library,
+                    "shadows",
+                    "shadow_vertex",
+                    "shadow_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                )?,
+            ),
+            (
+                "quads",
+                make_pipeline_descriptor(
+                    &library,
+                    "quads",
+                    "quad_vertex",
+                    "quad_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                )?,
+            ),
+            (
+                "underlines",
+                make_pipeline_descriptor(
+                    &library,
+                    "underlines",
+                    "underline_vertex",
+                    "underline_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                )?,
+            ),
+            (
+                "monochrome_sprites",
+                make_pipeline_descriptor(
+                    &library,
+                    "monochrome_sprites",
+                    "monochrome_sprite_vertex",
+                    "monochrome_sprite_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                )?,
+            ),
+            (
+                "polychrome_sprites",
+                make_pipeline_descriptor(
+                    &library,
+                    "polychrome_sprites",
+                    "polychrome_sprite_vertex",
+                    "polychrome_sprite_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                )?,
+            ),
+            (
+                "surfaces",
+                make_pipeline_descriptor(
+                    &library,
+                    "surfaces",
+                    "surface_vertex",
+                    "surface_fragment",
+                    MTLPixelFormat::BGRA8Unorm,
+                )?,
+            ),
+        ];
+        if let Some(archives) = &archive_array {
+            for (_, descriptor) in &mut descriptors {
+                descriptor.setBinaryArchives(Some(archives));
+            }
+        }
+
+        let shared_device = SendSync(device.clone());
+        let shared_descriptors: Vec<(&'static str, SendSync<Retained<MTLRenderPipelineDescriptor>>)> =
+            descriptors
+                .iter()
+                .map(|(label, desc)| (*label, SendSync(desc.clone())))
+                .collect();
+
+        let pipelines = std::thread::scope(|scope| {
+            let handles: Vec<_> = shared_descriptors
+                .into_iter()
+                .map(|(label, desc)| {
+                    let dev = &shared_device;
+                    scope.spawn(move || {
+                        let desc = desc;
+                        objc2::rc::autoreleasepool(|_| {
+                            dev.0
+                                .newRenderPipelineStateWithDescriptor_error(&desc.0)
+                                .with_context(|| format!("creating {label} render pipeline"))
+                                .map(SendSync)
+                        })
+                    })
+                })
+                .collect();
+
+            handles
+                .into_iter()
+                .map(|handle| {
+                    handle
+                        .join()
+                        .map_err(|_| anyhow::anyhow!("Metal pipeline compilation thread panicked"))?
+                        .map(|wrapped| wrapped.0)
+                })
+                .collect::<Result<Vec<_>>>()
+        })?;
+
+        if let (Some((archive, false)), Some(cache_path)) = (archive_state, cache_path) {
+            let bg_archive = SendSync(archive);
+            let bg_descriptors: Vec<SendSync<Retained<MTLRenderPipelineDescriptor>>> = descriptors
+                .into_iter()
+                .map(|(_, desc)| SendSync(desc))
+                .collect();
+            let _ = std::thread::Builder::new()
+                .name("metal-archive-save".into())
+                .spawn(move || {
+                    objc2::rc::autoreleasepool(|_| {
+                        let _ = &bg_archive;
+                        let _ = &bg_descriptors;
+                        let mut ok = true;
+                        for desc in &bg_descriptors {
+                            if bg_archive
+                                .0
+                                .addRenderPipelineFunctionsWithDescriptor_error(&desc.0)
+                                .is_err()
+                            {
+                                ok = false;
+                                break;
+                            }
+                        }
+                        if ok {
+                            let tmp_path = cache_path.with_extension(format!(
+                                "metallib.tmp.{}",
+                                std::process::id()
+                            ));
+                            let url = NSURL::fileURLWithPath(&NSString::from_str(
+                                &tmp_path.to_string_lossy(),
+                            ));
+                            if bg_archive.0.serializeToURL_error(&url).is_ok() {
+                                let _ = std::fs::rename(&tmp_path, &cache_path);
+                            } else {
+                                let _ = std::fs::remove_file(&tmp_path);
+                            }
+                        }
+                    });
+                });
+        }
+
+        let mut pipelines = pipelines.into_iter();
+        let paths_rasterization_pipeline_state = pipelines.next().unwrap();
+        let path_sprites_pipeline_state = pipelines.next().unwrap();
+        let shadows_pipeline_state = pipelines.next().unwrap();
+        let quads_pipeline_state = pipelines.next().unwrap();
+        let underlines_pipeline_state = pipelines.next().unwrap();
+        let monochrome_sprites_pipeline_state = pipelines.next().unwrap();
+        let polychrome_sprites_pipeline_state = pipelines.next().unwrap();
+        let surfaces_pipeline_state = pipelines.next().unwrap();
+
+        Ok(Self {
+            device,
+            is_apple_gpu,
+            is_unified_memory,
+            unit_vertices,
+            paths_rasterization_pipeline_state,
+            path_sprites_pipeline_state,
+            shadows_pipeline_state,
+            quads_pipeline_state,
+            underlines_pipeline_state,
+            monochrome_sprites_pipeline_state,
+            polychrome_sprites_pipeline_state,
+            surfaces_pipeline_state,
+        })
+    }
+}

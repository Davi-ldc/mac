+// Pixels are premultiplied while they are resized: filtering straight alpha would bleed the
+// colour of transparent pixels, often black, into the edges of what they surround.
+fn premultiply(pixels: &mut [u8], channels: usize) {
+    for pixel in pixels.chunks_exact_mut(channels) {
+        if let Some((alpha, colour)) = pixel.split_last_mut() {
+            let alpha = u32::from(*alpha);
+            for channel in colour {
+                *channel = ((u32::from(*channel) * alpha + 127) / 255) as u8;
             }
         }
     }
 }
 
+fn unpremultiply(pixels: &mut [u8], channels: usize) {
+    for pixel in pixels.chunks_exact_mut(channels) {
+        if let Some((alpha, colour)) = pixel.split_last_mut()
+            && *alpha > 0
+        {
+            let alpha = u32::from(*alpha);
+            for channel in colour {
+                *channel = ((u32::from(*channel) * 255 + alpha / 2) / alpha).min(255) as u8;
+            }
+        }
+    }
+}

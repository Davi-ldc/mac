+/// Downsamples BGRA frames wider than `max_width` to that width, keeping their aspect ratio, and
+/// returns the factor they shrank by.
+fn shrink_to_width(frames: &mut SmallVec<[Frame; 1]>, max_width: u32) -> f32 {
+    let Some(width) = frames.first().map(|frame| frame.buffer().width()) else {
+        return 1.;
+    };
+    if max_width == 0 || width <= max_width {
+        return 1.;
+    }
+    let shrink = max_width as f32 / width as f32;
+    let scale = |length: u32| ((length as f32 * shrink).round() as u32).max(1);
+    for frame in frames.iter_mut() {
+        let (left, top, delay) = (frame.left(), frame.top(), frame.delay());
+        let mut buffer = std::mem::replace(frame, Frame::new(RgbaImage::new(0, 0))).into_buffer();
+        let (new_width, new_height) = (scale(buffer.width()), scale(buffer.height()));
+        let has_alpha = buffer.pixels().any(|pixel| pixel[3] != u8::MAX);
+        if has_alpha {
+            premultiply(&mut buffer, 4);
+        }
+        let mut resized = imageops::thumbnail(&buffer, new_width, new_height);
+        drop(buffer);
+        if has_alpha {
+            unpremultiply(&mut resized, 4);
+        }
+        *frame = Frame::from_parts(resized, scale(left), scale(top), delay);
+    }
+    shrink
+}

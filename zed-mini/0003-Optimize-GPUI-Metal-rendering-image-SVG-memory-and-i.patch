+    #[cfg(feature = "runtime_shaders")]
+    feed(SHADERS_SOURCE_FILE.as_bytes());
+    #[cfg(not(feature = "runtime_shaders"))]
+    feed(SHADERS_METALLIB);
+    feed(b":");
+    feed(device.name().to_string().as_bytes());
+    feed(b":");
+    feed(
+        NSProcessInfo::processInfo()
+            .operatingSystemVersionString()
+            .to_string()
+            .as_bytes(),
+    );
+
+    let mut dir = std::path::PathBuf::from(home);
+    dir.push("Library/Caches/Zed Mini");
+    let _ = std::fs::create_dir_all(&dir);
+    dir.push(format!("metal-pipelines-{hash:016x}.metallib"));
+    Some(dir)
+}

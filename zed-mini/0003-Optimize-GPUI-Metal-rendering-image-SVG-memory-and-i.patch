+/// `None` when the frame draws no paths.
+fn path_texture_size(
+    scene: &Scene,
+    viewport_size: Size<DevicePixels>,
+) -> Option<Size<DevicePixels>> {
+    if scene.paths.is_empty() {
+        return None;
+    }
+    let mut largest: Option<(i32, i32)> = None;
+    for batch in scene.batches() {
+        if let PrimitiveBatch::Paths(range) = batch
+            && let Some(region) = path_batch_region(&scene.paths[range], viewport_size)
+        {
+            let (width, height) = largest.unwrap_or_default();
+            largest = Some((
+                width.max(region.size.width.0),
+                height.max(region.size.height.0),
+            ));
+        }
+    }
+    let round_up = |length: i32| {
+        (length + PATH_TEXTURE_GRANULARITY - 1) / PATH_TEXTURE_GRANULARITY
+            * PATH_TEXTURE_GRANULARITY
+    };
+    largest.map(|(width, height)| {
+        size(
+            DevicePixels(round_up(width).min(viewport_size.width.0)),
+            DevicePixels(round_up(height).min(viewport_size.height.0)),
+        )
+    })

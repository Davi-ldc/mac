     /// Marks the start of a scope (e.g. a window draw) whose allocations must stay
     /// live until the scope ends, even if `clear` is called by a nested scope in
     /// the meantime.
@@ -148,13 +160,33 @@ impl Arena {
     }
 
     fn force_clear(&mut self) {
+        const MAX_RETAINED_ELEMENT_CAPACITY: usize = 8192;
         self.valid.set(false);
         self.valid = Rc::new(Cell::new(true));
+        let used_elements = self.elements.len();
         self.elements.clear();
+        let used_chunks = self.current_chunk_index + 1;
         for chunk_index in 0..=self.current_chunk_index {
             self.chunks[chunk_index].reset();
         }
         self.current_chunk_index = 0;
+
+        if used_chunks < self.chunks.len()
+            || (self.elements.capacity() > MAX_RETAINED_ELEMENT_CAPACITY
+                && used_elements * 4 < self.elements.capacity())
+        {
+            self.low_usage_clears = self.low_usage_clears.saturating_add(1);
+            if self.low_usage_clears >= 2 {
+                self.chunks.truncate(used_chunks.max(1));
+                if self.elements.capacity() > MAX_RETAINED_ELEMENT_CAPACITY {
+                    self.elements
+                        .shrink_to(used_elements.max(MAX_RETAINED_ELEMENT_CAPACITY));
+                }
+                self.low_usage_clears = 0;
+            }
+        } else {
+            self.low_usage_clears = 0;
+        }
     }
 

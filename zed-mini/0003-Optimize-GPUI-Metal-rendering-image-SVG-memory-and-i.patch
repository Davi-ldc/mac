+/// Memory for an image's full-size decode scratch or cached pixel buffer that goes back to the
+/// system immediately when dropped. macOS's `xzone_malloc` keeps freed `Malloc Large` blocks (>32
+/// KiB) resident for reuse and does not give them up under `malloc_zone_pressure_relief`, so
+/// routing allocations >= 32 KiB through anonymous `mmap`/`munmap` ensures zero retained footprint
+/// after an image or preview is closed, while tiny allocations avoid `mmap` / page-rounding cost.
+#[cfg(target_os = "macos")]
+pub(crate) enum TransientBuffer {
+    Mapped {
+        pointer: std::ptr::NonNull<u8>,
+        len: usize,
+    },
+    Heap(Vec<u8>),
+}
+
+#[cfg(not(target_os = "macos"))]
+pub(crate) struct TransientBuffer {
+    data: Vec<u8>,
+}
+
+// SAFETY: the buffer owns its mapping exclusively, as a Vec owns its allocation.
+#[cfg(target_os = "macos")]
+unsafe impl Send for TransientBuffer {}
+#[cfg(target_os = "macos")]
+unsafe impl Sync for TransientBuffer {}
+
+impl TransientBuffer {
+    /// Allocations at or above 32 KiB (2 ARM64 pages) bypass `xzone_malloc`'s sticky large cache.
+    #[cfg(target_os = "macos")]
+    const MMAP_THRESHOLD: usize = 32 * 1024;
+
+    #[cfg(target_os = "macos")]
+    pub(crate) fn zeroed(len: usize) -> io::Result<Self> {
+        if len < Self::MMAP_THRESHOLD {
+            return Ok(Self::Heap(vec![0; len]));
+        }
+        // SAFETY: a new private anonymous mapping aliases no other memory.
+        let pointer = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        if pointer == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        let pointer = std::ptr::NonNull::new(pointer.cast::<u8>())
+            .ok_or_else(|| io::Error::other("mmap returned a null mapping"))?;
+        Ok(Self::Mapped { pointer, len })
+    }
+
+    #[cfg(not(target_os = "macos"))]
+    pub(crate) fn zeroed(len: usize) -> io::Result<Self> {
+        Ok(Self { data: vec![0; len] })
+    }
+
+    fn read_file(path: &Path) -> io::Result<Self> {
+        let mut file = fs::File::open(path)?;
+        let len = usize::try_from(file.metadata()?.len()).map_err(io::Error::other)?;
+        let mut buffer = Self::zeroed(len)?;
+        io::Read::read_exact(&mut file, &mut buffer)?;
+        Ok(buffer)
+    }
+}
+
+impl Deref for TransientBuffer {
+    type Target = [u8];
+
+    #[cfg(target_os = "macos")]
+    fn deref(&self) -> &[u8] {
+        match self {
+            // SAFETY: the mapping is `len` readable bytes for as long as `self` lives.
+            Self::Mapped { pointer, len } => unsafe {
+                std::slice::from_raw_parts(pointer.as_ptr(), *len)
+            },
+            Self::Heap(data) => data,
+        }
+    }
+
+    #[cfg(not(target_os = "macos"))]
+    fn deref(&self) -> &[u8] {
+        &self.data
+    }
+}
+
+impl DerefMut for TransientBuffer {
+    #[cfg(target_os = "macos")]
+    fn deref_mut(&mut self) -> &mut [u8] {
+        match self {
+            // SAFETY: as in `deref`, and `&mut self` makes this the only reference.
+            Self::Mapped { pointer, len } => unsafe {
+                std::slice::from_raw_parts_mut(pointer.as_ptr(), *len)
+            },
+            Self::Heap(data) => data,
+        }
+    }
+
+    #[cfg(not(target_os = "macos"))]
+    fn deref_mut(&mut self) -> &mut [u8] {
+        &mut self.data
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl Drop for TransientBuffer {
+    fn drop(&mut self) {
+        if let Self::Mapped { pointer, len } = self
+            && *len > 0
+        {
+            // SAFETY: the mapping came from `mmap` with this length and is unmapped only here.
+            unsafe { libc::munmap(pointer.as_ptr().cast(), *len) };
+        }
+    }
+}

+fn open_or_create_binary_archive(
+    device: &ProtocolObject<dyn MTLDevice>,
+    cache_path: Option<&std::path::Path>,
+) -> Option<(Retained<ProtocolObject<dyn MTLBinaryArchive>>, bool)> {
+    if let Some(path) = cache_path
+        && path.is_file()
+    {
+        let desc = MTLBinaryArchiveDescriptor::new();
+        let url = NSURL::fileURLWithPath(&NSString::from_str(&path.to_string_lossy()));
+        desc.setUrl(Some(&url));
+        if let Ok(archive) = device.newBinaryArchiveWithDescriptor_error(&desc) {
+            return Some((archive, true));
+        }
+    }
+    let desc = MTLBinaryArchiveDescriptor::new();
+    device
+        .newBinaryArchiveWithDescriptor_error(&desc)
+        .ok()
+        .map(|archive| (archive, false))
+}

+#[cfg(target_os = "macos")]
+fn release_malloc_pressure() {
+    unsafe extern "C" {
+        fn malloc_zone_pressure_relief(zone: *mut std::ffi::c_void, goal: usize) -> usize;
+    }
+    // SAFETY: Passing NULL asks macOS libmalloc to purge empty magazines across all zones.
+    unsafe {
+        malloc_zone_pressure_relief(std::ptr::null_mut(), 0);
+    }
+}
+
+/// Decodes a still image no wider than `max_width` (and no taller than 4096 px) directly into a
+/// BGRA [`TransientBuffer`] (`mmap`/`munmap` on macOS). Neither the full-size decode scratch nor
+/// the downsampled `RenderImage` buffer touches macOS `xzone_malloc`'s sticky `Malloc Large`
+/// cache, so closing a preview returns 100% of its pixel memory to the OS immediately.
+/// Returns `None` for formats or pixel types the caller should decode as usual.
+fn decode_still_image_at_most_wide(
+    bytes: &[u8],
+    format: ImageFormat,
+    max_width: u32,
+) -> Result<Option<RenderImage>, ImageCacheError> {
+    const MAX_RASTER_SIDE: u32 = 4096;
+    if max_width == 0 {
+        return Ok(None);
+    }
+    let mut decoder =
+        image::ImageReader::with_format(io::Cursor::new(bytes), format).into_decoder()?;
+    let color_type = decoder.color_type();
+    if !matches!(
+        color_type,
+        ColorType::L8 | ColorType::La8 | ColorType::Rgb8 | ColorType::Rgba8
+    ) {
+        return Ok(None);
+    }
+    let orientation = decoder.orientation()?;
+    let (width, height) = decoder.dimensions();
+    if width == 0 || height == 0 {
+        return Ok(None);
+    }
+    let mut pixels =
+        TransientBuffer::zeroed(usize::try_from(decoder.total_bytes()).map_err(io::Error::other)?)?;
+    decoder.read_image(&mut pixels)?;
+
+    let swaps_axes = matches!(
+        orientation,
+        Orientation::Rotate90
+            | Orientation::Rotate270
+            | Orientation::Rotate90FlipH
+            | Orientation::Rotate270FlipH
+    );
+    let (drawn_width, drawn_height) = if swaps_axes {
+        (height, width)
+    } else {
+        (width, height)
+    };
+    let clamped_width = max_width.min(MAX_RASTER_SIDE);
+    let shrink = (clamped_width as f32 / drawn_width as f32)
+        .min(MAX_RASTER_SIDE as f32 / drawn_height as f32)
+        .min(1.);
+    let scale = |length: u32| ((length as f32 * shrink).round() as u32).max(1);
+    let scaled_w = scale(width);
+    let scaled_h = scale(height);
+    let (out_w, out_h) = if swaps_axes {
+        (scaled_h, scaled_w)

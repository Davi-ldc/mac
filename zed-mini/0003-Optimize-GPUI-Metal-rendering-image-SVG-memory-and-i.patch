+/// Loads images as [`ImageAssetLoader`] does, but rasterizes an SVG no larger than
+/// [`ICON_MAX_RASTER_SIZE`]. [`ImageAssetLoader`] rasterizes an SVG at twice its viewBox, whatever
+/// size it is drawn at, and some icon themes draw on canvases thousands of units wide, which
+/// would make an icon a raster of hundreds of megabytes that stays cached for the session.
+#[derive(Clone)]
+pub enum IconAssetLoader {}
+
+impl Asset for IconAssetLoader {
+    type Source = Resource;
+    type Output = Result<Arc<RenderImage>, ImageCacheError>;
+
+    fn load(
+        source: Self::Source,
+        cx: &mut App,
+    ) -> impl Future<Output = Self::Output> + Send + 'static {
+        load_image(source, Some(ICON_MAX_RASTER_SIZE), None, cx)
+    }

+/// The part of the viewport a batch of paths draws into, on whole device pixels, or `None`
+/// when the batch lies outside the viewport.
+fn path_batch_region(
+    paths: &[Path<ScaledPixels>],
+    viewport_size: Size<DevicePixels>,
+) -> Option<Bounds<DevicePixels>> {
+    let (mut left, mut top, mut right, mut bottom) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+    for path in paths {
+        let bounds = path.clipped_bounds();
+        if bounds.size.width.0 > 0. && bounds.size.height.0 > 0. {
+            left = left.min(bounds.origin.x.0);
+            top = top.min(bounds.origin.y.0);
+            right = right.max(bounds.origin.x.0 + bounds.size.width.0);
+            bottom = bottom.max(bounds.origin.y.0 + bounds.size.height.0);
+        }
+    }
+    let left = (left.floor() as i32).max(0);
+    let top = (top.floor() as i32).max(0);
+    let right = (right.ceil() as i32).min(viewport_size.width.0);
+    let bottom = (bottom.ceil() as i32).min(viewport_size.height.0);
+    (right > left && bottom > top).then(|| Bounds {
+        origin: point(DevicePixels(left), DevicePixels(top)),
+        size: size(DevicePixels(right - left), DevicePixels(bottom - top)),
+    })
+}
+
+fn path_region_origin(region: Bounds<DevicePixels>) -> Point<ScaledPixels> {
+    point(
+        ScaledPixels(region.origin.x.0 as f32),
+        ScaledPixels(region.origin.y.0 as f32),
+    )
+}

+    /// Closes the preview shown beside the active markdown editor, or opens one there that
+    /// follows the active markdown file. From a preview, closes it and returns to its source.
+    fn toggle_preview(
+        workspace: &mut Workspace,
+        window: &mut Window,
+        cx: &mut Context<Workspace>,
+    ) {
+        let Some(active_item) = workspace.active_item(cx) else {
+            return;
+        };
+        if let Some(preview) = active_item.downcast::<MarkdownPreviewView>() {
+            preview.update(cx, |preview, cx| {
+                preview.close_and_return_to_editor(&CloseAndReturnToEditor, window, cx)
+            });
+            return;
+        }
+        let Some(editor) = active_item
+            .act_as::<Editor>(cx)
+            .filter(|editor| Self::is_markdown_file(editor, cx))
+        else {
+            return;
+        };
+        let Some(buffer) = editor.read(cx).buffer().read(cx).as_singleton() else {
+            return;
+        };
+        let editor_pane = workspace.active_pane().clone();
+        let preview_beside = workspace
+            .panes()
+            .iter()
+            .filter(|pane| **pane != editor_pane)
+            .find_map(|pane| {
+                let preview = pane
+                    .read(cx)
+                    .items_of_type::<MarkdownPreviewView>()
+                    .find(|preview| preview.read(cx).is_previewing(&buffer, cx))?;
+                Some((pane.clone(), preview))
+            });
+
+        match preview_beside {
+            Some((pane, preview)) => pane.update(cx, |pane, cx| {
+                let shown = pane
+                    .active_item()
+                    .is_some_and(|item| item.item_id() == preview.entity_id());
+                if shown {
+                    pane.close_item_by_id(preview.entity_id(), SaveIntent::Skip, window, cx)
+                        .detach_and_log_err(cx);
+                } else if let Some(index) = pane.index_for_item(&preview) {
+                    pane.activate_item(index, false, false, window, cx);
+                }
+            }),
+            None => {
+                let preview =
+                    Self::create_following_markdown_view(workspace, editor.clone(), window, cx);
+                let pane = workspace.adjacent_pane_of(&editor_pane, window, cx);
+                pane.update(cx, |pane, cx| {
+                    pane.add_item(Box::new(preview), false, false, None, window, cx)
+                });
+                editor.focus_handle(cx).focus(window, cx);
+            }
+        }
+    }

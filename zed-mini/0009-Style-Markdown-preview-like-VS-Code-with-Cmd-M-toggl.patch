+/// The preview's images, each decoded no wider than the preview draws images, so a screenshot
+/// several times wider than the preview holds only the pixels it is drawn with. An image the
+/// preview stops drawing (an edit removed it, or a following preview moved to another file) is
+/// released at the next render, and all of them when the preview closes.
+struct PreviewImageCache {
+    images: HashMap<u64, PreviewImage>,
+    /// See [`MarkdownPreviewView::image_max_width`].
+    max_width: Option<u32>,
+    render_count: u64,
+    pending_sweep: bool,
+}
+
+struct PreviewImage {
+    /// The load, and the width it was limited to.
+    loaded: (ImageCacheItem, u32),
+    /// A load at the preview's current width, which replaces `loaded` once it finishes.
+    reload: Option<(ImageCacheItem, u32)>,
+    last_drawn_in_render: u64,
+}
+
+impl PreviewImageCache {
+    fn new(cx: &mut App) -> Entity<Self> {
+        let image_cache = cx.new(|_| Self {
+            images: HashMap::default(),
+            max_width: None,
+            render_count: 0,
+            pending_sweep: false,
+        });
+        cx.observe_release(&image_cache, |image_cache, cx| {
+            for (_, image) in image_cache.images.drain() {
+                image.release(None, cx);
+            }
+            cx.reclaim_memory();
+        })
+        .detach();
+        image_cache
+    }
+
+    /// Runs as the preview renders, before it lays out (and so loads) this frame's images.
+    /// Sweeping is deferred until after the frame completes so double renders within one
+    /// frame or transient zero-width layouts never evict still-visible images.
+    fn start_render(
+        &mut self,
+        max_width: Option<u32>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(max_width) = max_width else {
+            return;
+        };
+        self.max_width = Some(max_width);
+        if self.pending_sweep {
+            return;
+        }
+        self.render_count += 1;
+        let expected_render = self.render_count;
+        self.pending_sweep = true;
+        cx.on_next_frame(window, move |this, window, cx| {
+            this.pending_sweep = false;
+            let mut window = Some(window);
+            this.images.retain(|_, image| {
+                let drawn = image.last_drawn_in_render >= expected_render;
+                if !drawn {
+                    image.release(window.as_deref_mut(), cx);
+                }
+                drawn
+            });
+        });
+    }
+}
+
+impl PreviewImage {
+    fn release(&self, mut window: Option<&mut Window>, cx: &mut App) {
+        for (item, _) in [Some(&self.loaded), self.reload.as_ref()].into_iter().flatten() {
+            if let Some(Ok(image)) = item.get() {
+                cx.drop_image(image, window.as_deref_mut());
+            }
+        }
+    }
+}
+
+impl ImageCache for PreviewImageCache {
+    fn load(
+        &mut self,
+        resource: &Resource,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Option<Result<Arc<RenderImage>, ImageCacheError>> {
+        let max_width = self.max_width?;
+        let render_count = self.render_count;
+        let image = self
+            .images
+            .entry(gpui::hash(resource))
+            .or_insert_with(|| PreviewImage {
+                loaded: (
+                    ImageCacheItem::new_at_most_wide(resource, max_width, cx),
+                    max_width,
+                ),
+                reload: None,
+                last_drawn_in_render: render_count,
+            });
+        image.last_drawn_in_render = render_count;
+
+        if let Some((reload, _)) = &image.reload
+            && reload.use_image(window).is_some()
+            && let Some(reload) = image.reload.take()
+        {
+            let (previous, _) = std::mem::replace(&mut image.loaded, reload);
+            if let Some(Ok(previous)) = previous.get() {
+                cx.drop_image(previous, Some(window));
+            }
+        }
+
+        let result = image.loaded.0.use_image(window);
+        if let Some(Ok(loaded)) = &result
+            && image.reload.is_none()
+        {
+            let width = loaded.size(0).width.0.max(0) as u32;
+            let limit = image.loaded.1;
+            // An image cut to its limit has more to show in a wider preview; any image wider
+            // than the preview now draws it holds pixels nobody sees.
+            let was_cut = width + 1 >= limit;
+            if limit != max_width && ((was_cut && max_width > limit) || width > max_width) {
+                let reload = ImageCacheItem::new_at_most_wide(resource, max_width, cx);
+                reload.use_image(window);
+                image.reload = Some((reload, max_width));
+            }
+        }
+        result
+    }
+}

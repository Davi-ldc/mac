+    /// The widest the preview draws an image, in device pixels: its column at the window's scale,
+    /// rounded up so that resizing the preview reloads images in steps. `None` until the preview
+    /// has been laid out, which the render on the next frame can then use.
+    fn image_max_width(&self, window: &mut Window, cx: &mut Context<Self>) -> Option<u32> {
+        const STEP: f32 = 128.;
+        let mut column = self.scroll_handle.bounds().size.width;
+        if let Some(max_width) = MarkdownPreviewSettings::get_global(cx).max_width
+            && max_width > px(0.)
+            && max_width < column
+        {
+            column = max_width;
+        }
+        if column <= px(0.) {
+            if !self.retried_zero_width_image_layout.replace(true) {
+                cx.on_next_frame(window, |_, _, cx| cx.notify());
+            }
+            return None;
+        }
+        self.retried_zero_width_image_layout.set(false);
+        Some(((f32::from(column) * window.scale_factor() / STEP).ceil() * STEP) as u32)
+    }

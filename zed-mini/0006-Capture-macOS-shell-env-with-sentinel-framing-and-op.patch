+#[cfg(target_os = "macos")]
+fn parse_nul_env_map(
+    output: &[u8],
+    sentinel: &[u8],
+) -> Result<collections::HashMap<String, String>> {
+    let mut marker = Vec::with_capacity(sentinel.len() + 1);
+    marker.extend_from_slice(sentinel);
+    marker.push(0);
+    let Some(marker_pos) = output
+        .windows(marker.len())
+        .position(|window| window == marker.as_slice())
+    else {
+        anyhow::bail!(
+            "Failed to find environment sentinel in shell output: {}",
+            String::from_utf8_lossy(output)
+        );
+    };
+    let payload = &output[marker_pos + marker.len()..];
+
+    let mut env_map = collections::HashMap::default();
+    for entry in payload.split(|&byte| byte == 0) {
+        if entry.is_empty() {
+            continue;
+        }
+        let Some(eq_pos) = entry.iter().position(|&byte| byte == b'=') else {
+            continue;
+        };
+        if eq_pos == 0 {
+            continue;
+        }
+        let (Ok(key), Ok(value)) = (
+            std::str::from_utf8(&entry[..eq_pos]),
+            std::str::from_utf8(&entry[eq_pos + 1..]),
+        ) else {
+            log::debug!("skipping non-UTF-8 environment variable entry from login shell");
+            continue;
+        };
+        env_map.insert(key.to_owned(), value.to_owned());
+    }
+    if env_map.is_empty() {
+        anyhow::bail!(
+            "Failed to find environment variables in shell output: {}",
+            String::from_utf8_lossy(payload)
+        );
+    }
+    Ok(env_map)
+}

+
+/// Resolves an initial git binary without waiting on a per-repo login shell and
+/// without touching macOS's `/usr/bin/git` shim when Xcode CLT is not installed.
+fn find_initial_git_binary() -> Option<PathBuf> {
+    #[cfg(target_os = "macos")]
+    {
+        let has_clt = || {
+            Path::new("/Library/Developer/CommandLineTools/usr/bin/git").is_file()
+                || Path::new("/Applications/Xcode.app/Contents/Developer/usr/bin/git").is_file()
+        };
+        if !util::is_login_shell_environment_loaded() {
+            // Avoid reading PATH via getenv concurrently with load_login_shell_environment.
+            for candidate in ["/opt/homebrew/bin/git", "/usr/local/bin/git"] {
+                let path = Path::new(candidate);
+                if path.is_file() {
+                    return Some(path.to_path_buf());
+                }
+            }
+            if has_clt() && Path::new("/usr/bin/git").is_file() {
+                return Some(PathBuf::from("/usr/bin/git"));
+            }
+            return None;
+        }
+        let path = which::which("git").ok()?;
+        if path == Path::new("/usr/bin/git") && !has_clt() {
+            return None;
+        }
+        Some(path)
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        which::which("git").ok()
+    }
 }
 

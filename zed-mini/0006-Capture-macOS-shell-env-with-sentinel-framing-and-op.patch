+        let path_arg = current_path.as_unix_str().to_string();
+        self.executor
+            .spawn(async move {
+                let output = git
+                    .build_command(&[
+                        "log",
+                        "--follow",
+                        "--format=COMMIT:%H",
+                        "--name-only",
+                        "-z",
+                        "--",
+                        &path_arg,
+                    ])
+                    .output()
+                    .await?;
+                if !output.status.success() {
+                    return Ok(None);
+                }
+                let mut found_commit = false;
+                for token in output.stdout.split(|&byte| byte == 0) {
+                    if found_commit {
+                        let path_bytes = token.strip_prefix(b"\n").unwrap_or(token);
+                        if !path_bytes.is_empty() {
+                            return Ok(std::str::from_utf8(path_bytes).ok().map(str::to_string));
+                        }
+                        continue;
+                    }
+                    if let Some(sha) = token.strip_prefix(b"COMMIT:")
+                        && sha == target_commit.as_bytes()
+                    {
+                        found_commit = true;
+                    }
+                }
+                Ok(None)
+            })
+            .boxed()
+    }

+/// Defers `ReqwestClient` construction (including macOS Keychain root CA loading
+/// and TLS config initialization) until the first outbound HTTP request.
+struct LazyHttpClient {
+    proxy: Option<http_client::Url>,
+    user_agent: Option<http_client::http::HeaderValue>,
+    build: Box<dyn Fn() -> anyhow::Result<Arc<ReqwestClient>> + Send + Sync>,
+    inner: OnceLock<Arc<ReqwestClient>>,
+}
+
+impl LazyHttpClient {
+    fn new(
+        proxy: Option<http_client::Url>,
+        user_agent_str: String,
+        build: impl Fn() -> anyhow::Result<Arc<ReqwestClient>> + Send + Sync + 'static,
+    ) -> Self {
+        let user_agent = http_client::http::HeaderValue::from_str(&user_agent_str).ok();
+        Self {
+            proxy,
+            user_agent,
+            build: Box::new(build),
+            inner: OnceLock::new(),
+        }
+    }
+
+    fn get_or_init(&self) -> anyhow::Result<Arc<ReqwestClient>> {
+        if let Some(client) = self.inner.get() {
+            return Ok(client.clone());
+        }
+        let client = (self.build)()?;
+        let _ = self.inner.set(client.clone());
+        Ok(self.inner.get().cloned().unwrap_or(client))
+    }
+}
+
+impl http_client::HttpClient for LazyHttpClient {
+    fn user_agent(&self) -> Option<&http_client::http::HeaderValue> {
+        self.user_agent.as_ref()
+    }
+
+    fn proxy(&self) -> Option<&http_client::Url> {
+        self.proxy.as_ref()
+    }
+
+    fn send(
+        &self,
+        req: http_client::http::Request<http_client::AsyncBody>,
+    ) -> futures::future::BoxFuture<
+        'static,
+        anyhow::Result<http_client::Response<http_client::AsyncBody>>,
+    > {
+        match self.get_or_init() {
+            Ok(client) => client.send(req),
+            Err(err) => futures::future::ready(Err(err)).boxed(),
+        }
+    }
+}

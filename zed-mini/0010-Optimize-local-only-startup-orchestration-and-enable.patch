+fn add_outline_section(
+    workspace: &mut Workspace,
+    project_panel: &Entity<ProjectPanel>,
+    outline_panel: Entity<OutlinePanel>,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) {
+    const TITLE: &str = "Outline";
+    let focus_handle = outline_panel.read(cx).activation_focus_handle(cx);
+    let set_visible = {
+        let outline_panel = outline_panel.downgrade();
+        move |visible: bool, window: &mut Window, cx: &mut App| {
+            outline_panel
+                .update(cx, |outline_panel, cx| {
+                    outline_panel.set_active(visible, window, cx)
+                })
+                .log_err();
+        }
+    };
+    let outline_for_symbols = outline_panel.downgrade();
+    project_panel.update(cx, |project_panel, cx| {
+        project_panel.add_section(
+            project_panel::ExplorerSection {
+                title: TITLE.into(),
+                view: outline_panel.into(),
+                focus_handle,
+                set_visible: Rc::new(set_visible),
+                expanded: false,
+            },
+            window,
+            cx,
+        )
+    });
+    workspace.register_action(|workspace, _: &outline_panel::ToggleFocus, window, cx| {
+        project_panel::toggle_section_focus(workspace, TITLE, window, cx);
+    });
+    workspace.register_action(|workspace, _: &outline_panel::Toggle, window, cx| {
+        project_panel::toggle_section_visibility(workspace, TITLE, window, cx);
+    });
+    workspace.register_action(move |_, _: &outline_panel::ToggleSymbols, window, cx| {
+        if let Some(outline_panel) = outline_for_symbols.upgrade() {
+            window.defer(cx, move |window, cx| {
+                outline_panel.update(cx, |outline_panel, cx| {
+                    outline_panel.toggle_symbols(&outline_panel::ToggleSymbols, window, cx);
+                });
+            });
+        }
+    });
+}

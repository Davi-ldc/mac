+                    .px(rems_from_vscode_px(4.))
+                    .flex()
+                    .items_center()
+                    .justify_center()
+                    .rounded_full()
+                    .bg(colors.activity_bar_badge_background)
+                    .text_color(colors.activity_bar_badge_foreground)
+                    .text_size(rems_from_vscode_px(9.))
+                    .child(badge)
+            }))
+            .tooltip(Tooltip::for_action_title(tooltip, &*action))
+            .on_click(move |_, window, cx| {
+                window.focus(&focus_handle, cx);
+                window.dispatch_action(action.boxed_clone(), cx)
+            })
+            .into_any_element()
+    }
+}
+
+impl Render for ActivityBar {
+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let dock = self.dock.read(cx);
+        let focus_handle = dock.panel_button_focus_handle(window, cx);
+        let mut items: Vec<AnyElement> = dock
+            .panel_entries
+            .iter()
+            .enumerate()
+            .filter_map(|(index, entry)| {
+                let icon = entry.panel.icon(window, cx)?;
+                let tooltip = entry.panel.icon_tooltip(window, cx)?;
+                // Clicking the open panel's button closes the dock, as in VS Code.
+                let is_active = Some(index) == dock.active_panel_index && dock.is_open;
+                let action = if is_active {
+                    dock.toggle_action()
+                } else {
+                    entry.panel.toggle_action(window, cx)
+                };
+                Some(Self::item(
+                    entry.panel.persistent_name(),
+                    icon,
+                    tooltip.into(),
+                    action,
+                    is_active,
+                    entry.panel.icon_label(window, cx).map(SharedString::from),
+                    focus_handle.clone(),
+                    cx,
+                ))
+            })
+            .collect();
+        items.insert(
+            items.len().min(1),
+            Self::item(
+                "Search",
+                IconName::MagnifyingGlass,
+                "Search".into(),
+                Box::new(crate::DeploySearch::default()),
+                false,
+                None,
+                focus_handle,
+                cx,
+            ),
+        );
+
+        let colors = cx.theme().colors();
+        let (foreground, hover_background) =
+            (colors.activity_bar_foreground, colors.ghost_element_hover);
+        v_flex()
+            .id("activity-bar")
+            .w(ACTIVITY_BAR_WIDTH)
+            .h_full()
+            .flex_none()
+            .pt(ACTIONS_INSET)
+            .pb(ACTIONS_INSET)
+            .gap(ACTION_GAP)
+            .bg(colors.activity_bar_background)
+            .border_r(px(1.) / window.scale_factor())
+            .border_color(colors.border)
+            .children(items)
+            .child(div().flex_1())
+            .child(
+                PopoverMenu::new("activity-bar-manage")
+                    .trigger_with_tooltip(
+                        ButtonLike::new("activity-bar-manage-button")
+                            .style(ButtonStyle::Transparent)
+                            .height(ACTION_HEIGHT.into())
+                            .width(ACTIVITY_BAR_WIDTH)
+                            .child(
+                                h_flex()
+                                    .group("activity-bar-manage")
+                                    .w(ACTIVITY_BAR_WIDTH)
+                                    .h(ACTION_HEIGHT)
+                                    .relative()
+                                    .justify_center()
+                                    .child(
+                                        div()
+                                            .absolute()
+                                            .size(ACTION_INDICATOR_SIZE)
+                                            .rounded(px(4.))
+                                            .group_hover("activity-bar-manage", move |style| {
+                                                style.bg(hover_background)
+                                            }),
+                                    )
+                                    .child(
+                                        svg()
+                                            .path(IconName::Settings.path())
+                                            .size(ACTION_ICON_SIZE)
+                                            .text_color(colors.activity_bar_inactive_foreground)
+                                            .group_hover("activity-bar-manage", move |style| {
+                                                style.text_color(foreground)
+                                            }),
+                                    ),
+                            ),
+                        Tooltip::text("Manage"),
+                    )
+                    .anchor(Anchor::BottomLeft)
+                    .attach(Anchor::TopRight)
+                    .menu(|window, cx| {
+                        Some(ContextMenu::build(window, cx, |menu, _, _| {
+                            menu.action(
+                                "Command Palette",
+                                zed_actions::command_palette::Toggle.boxed_clone(),
+                            )
+                            .separator()
+                            .action("Settings", zed_actions::OpenSettings.boxed_clone())
+                            .action("Keyboard Shortcuts", zed_actions::OpenKeymap.boxed_clone())
+                            .separator()
+                            .action(
+                                "Themes",
+                                zed_actions::theme_selector::Toggle::default().boxed_clone(),
+                            )
+                            .action(
+                                "Icon Themes",
+                                zed_actions::icon_theme_selector::Toggle::default().boxed_clone(),
+                            )
+                        }))
+                    }),
+            )
+    }
+}

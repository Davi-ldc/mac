+/// VS Code's breadcrumbs under the tabs: 13 px items in the muted text colour (its
+/// breadcrumb.foreground) after 16 px of space, the file's folders and the file as items of
+/// their own (folders without an icon, the file with its icon 6 px before the name), symbols as
+/// plain text, and the chevron codicon in a 16 px box between items.
+fn render_breadcrumbs_bar(
+    segments: Vec<HighlightedText>,
+    prefix: Option<gpui::AnyElement>,
+    active_item: &dyn ItemHandle,
+    cx: &App,
+) -> gpui::AnyElement {
+    let item =
+        |icon: Option<SharedString>, text: String, emphasized: bool| {
+            h_flex()
+                .flex_none()
+                .gap(rems_from_vscode_px(6.))
+                .children(icon.map(|icon| {
+                    Icon::from_path(icon).size(IconSize::Custom(rems_from_vscode_px(16.)))
+                }))
+                .child(Label::new(text).single_line().map(|label| {
+                    if emphasized {
+                        label.color(Color::Default).weight(FontWeight::BOLD)
+                    } else {
+                        label.color(Color::Muted)
+                    }
+                }))
+                .into_any_element()
+        };
+
+    let file_name = active_item
+        .project_path(cx)
+        .and_then(|project_path| Some(project_path.path.file_name()?.to_string()));
+    // Without a tab bar, the breadcrumbs are what shows that the file has unsaved changes.
+    let emphasize_file =
+        !workspace::TabBarSettings::get_global(cx).show && active_item.is_dirty(cx);
+
+    let mut items = Vec::new();
+    let mut segments = segments
+        .into_iter()
+        .map(|segment| segment.text.replace('\n', " "));
+    if let Some(path) = segments.next() {
+        let matched_file_name = file_name.filter(|file_name| {
+            !path.contains(" ↔ ")
+                && path.ends_with(file_name.as_str())
+                && (path.len() == file_name.len()
+                    || matches!(
+                        path.as_bytes()[path.len() - file_name.len() - 1],
+                        b'/' | b'\\'
+                    ))
+        });
+        match matched_file_name {
+            Some(file_name) => {
+                let folders = &path[..path.len() - file_name.len()];
+                items.extend(
+                    folders
+                        .split(['/', '\\'])
+                        .filter(|folder| !folder.is_empty())
+                        .map(|folder| item(None, folder.to_string(), false)),
+                );
+                let icon = file_icons::FileIcons::get_icon(std::path::Path::new(&file_name), cx);
+                items.push(item(icon, file_name, emphasize_file));
+            }
+            None => items.push(item(None, path, false)),
+        }
+    }
+    items.extend(segments.map(|symbol| item(None, symbol, false)));
+
+    let separator = || {
+        Icon::new(IconName::BreadcrumbSeparator)
+            .size(IconSize::Custom(rems_from_vscode_px(16.)))
+            .color(Color::Muted)
+            .into_any_element()
+    };
+    h_flex()
+        .h(rems_from_vscode_px(22.))
+        .pl(rems_from_vscode_px(16.))
+        .pr(rems_from_vscode_px(8.))
+        .children(prefix)
+        .children(Itertools::intersperse_with(items.into_iter(), separator))

+/// Opens the project panel with the section titled `title` expanded, and focuses the section.
+pub fn focus_section(
+    workspace: &mut Workspace,
+    title: &str,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) {
+    let Some(project_panel) = workspace.panel::<ProjectPanel>(cx) else {
+        return;
+    };
+    workspace.reveal_panel::<ProjectPanel>(window, cx);
+    if let Some(focus_handle) =
+        project_panel.update(cx, |panel, cx| panel.expand_section(title, window, cx))
+    {
+        window.focus(&focus_handle, cx);
+    }
+}
+
+/// Focuses the Explorer section titled `title`, or returns focus to the active center pane
+/// if the section is already expanded and focused.
+pub fn toggle_section_focus(
+    workspace: &mut Workspace,
+    title: &str,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) {
+    let Some(project_panel) = workspace.panel::<ProjectPanel>(cx) else {
+        return;
+    };
+    let already_focused = {
+        let panel = project_panel.read(cx);
+        panel.is_visible && panel.is_section_expanded_and_focused(title, window, cx)
+    };
+    if already_focused {
+        let active_pane_focus = workspace.active_pane().read(cx).focus_handle(cx);
+        window.focus(&active_pane_focus, cx);
+    } else {
+        focus_section(workspace, title, window, cx);
+    }
+}
+
+/// Toggles the Explorer section titled `title`: collapses it (and returns focus to the active
+/// center pane if it was focused) when currently visible and expanded, otherwise opens and
+/// focuses it.
+pub fn toggle_section_visibility(
+    workspace: &mut Workspace,
+    title: &str,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) {
+    let Some(project_panel) = workspace.panel::<ProjectPanel>(cx) else {
+        return;
+    };
+    let is_open_and_expanded = {
+        let panel = project_panel.read(cx);
+        panel.is_visible && panel.is_section_expanded(title)
+    };
+    if is_open_and_expanded {
+        let was_focused = project_panel
+            .read(cx)
+            .is_section_expanded_and_focused(title, window, cx);
+        project_panel.update(cx, |panel, cx| panel.collapse_section(title, window, cx));
+        if was_focused {
+            let active_pane_focus = workspace.active_pane().read(cx).focus_handle(cx);
+            window.focus(&active_pane_focus, cx);
+        }
+    } else {
+        focus_section(workspace, title, window, cx);
+    }
+}

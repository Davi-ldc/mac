+    async fn test_should_defer_inactive_tabs_distinguishes_dir_root_and_files(
+        cx: &mut TestAppContext,
+    ) {
+        init_test(cx);
+
+        let fs = FakeFs::new(cx.executor());
+        fs.insert_tree(
+            path!("/project"),
+            json!({
+                "main.rs": "fn main() {}",
+            }),
+        )
+        .await;
+        fs.insert_file(path!("/standalone.txt"), "hello".into())
+            .await;
+
+        let project = Project::test(fs, [path!("/project").as_ref()], cx).await;
+        let dir_worktree_id = project.read_with(cx, |project, cx| {
+            project.worktrees(cx).next().unwrap().read(cx).id()
+        });
+        let single_file_worktree_id = project
+            .update(cx, |project, cx| {
+                project.find_or_create_worktree(path!("/standalone.txt"), true, cx)
+            })
+            .await
+            .unwrap()
+            .0
+            .read_with(cx, |wt, _| wt.id());
+
+        project.read_with(cx, |project, cx| {
+            // Empty paths or directory worktree roots allow deferring inactive tabs.
+            assert!(should_defer_inactive_tabs(&[], project, cx));
+            assert!(should_defer_inactive_tabs(
+                &[Some(ProjectPath {
+                    worktree_id: dir_worktree_id,
+                    path: RelPath::empty().into(),
+                })],
+                project,
+                cx,
+            ));
+            // Explicit file inside a directory worktree must not defer.
+            assert!(!should_defer_inactive_tabs(
+                &[Some(ProjectPath {
+                    worktree_id: dir_worktree_id,
+                    path: rel_path("main.rs").into(),
+                })],
+                project,
+                cx,
+            ));
+            // Single-file worktree has empty relative path but represents an explicit file.
+            assert!(!should_defer_inactive_tabs(
+                &[Some(ProjectPath {
+                    worktree_id: single_file_worktree_id,
+                    path: RelPath::empty().into(),
+                })],
+                project,
+                cx,
+            ));
+        });
+    }

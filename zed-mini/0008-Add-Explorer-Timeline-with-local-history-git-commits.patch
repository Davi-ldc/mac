+//! A copy of every saved version of a local file, as VS Code's local history keeps, so the
+//! timeline can show and diff versions that were never committed.
+//!
+//! Each file gets a folder under `<data dir>/local_history`, named by a hash of its path,
+//! holding a `path` file with the original path and one snapshot per save, named by the save
+//! time in milliseconds.
+
+use anyhow::{Context as _, Result};
+use gpui::{App, AppContext as _, Context, Entity, EventEmitter, Global, Task};
+use language::{Buffer, BufferEvent};
+use project::{Project, buffer_store::BufferStoreEvent};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+    time::{SystemTime, UNIX_EPOCH},
+};
+use util::ResultExt as _;
+
+/// VS Code's defaults for `workbench.localHistory.maxFileEntries` and `maxFileSize`.
+const MAX_ENTRIES_PER_FILE: usize = 50;
+const MAX_FILE_SIZE: u64 = 256 * 1024;
+/// VS Code has no limit on the whole history; this one keeps it bounded however many files
+/// get saved. Past it, the oldest snapshots of any file go first.
+const MAX_TOTAL_SIZE: u64 = 32 * 1024 * 1024;
+const PATH_FILE_NAME: &str = "path";
+
+pub struct LocalHistory {
+    root: PathBuf,
+    requests: smol::channel::Sender<PathBuf>,
+    _tasks: [Task<()>; 2],
+}
+
+/// Emitted once the snapshot of a save is on disk.
+pub struct SnapshotSaved(pub PathBuf);
+
+impl EventEmitter<SnapshotSaved> for LocalHistory {}
+
+struct GlobalLocalHistory(Entity<LocalHistory>);
+
+impl Global for GlobalLocalHistory {}
+
+/// A saved version of a file.
+#[derive(Clone)]
+pub struct LocalHistoryEntry {
+    /// Milliseconds since the Unix epoch.
+    pub saved_at: i64,
+    pub snapshot: PathBuf,
+}
+
+pub fn init(cx: &mut App) {
+    let history = cx.new(|cx| LocalHistory::new(paths::data_dir().join("local_history"), cx));
+    cx.set_global(GlobalLocalHistory(history));
+    // Buffers are created through entity reservations, which `observe_new` doesn't see, so
+    // saves are found through each project's buffer store.
+    cx.observe_new(|project: &mut Project, _, cx| {
+        cx.subscribe(project.buffer_store(), |_, _, event, cx| {
+            if let BufferStoreEvent::BufferAdded(buffer) = event {
+                cx.subscribe(buffer, |_, buffer, event, cx| {
+                    if matches!(event, BufferEvent::Saved) {
+                        record_save(&buffer, cx);
+                    }
+                })
+                .detach();
+            }
+        })
+        .detach();
+    })
+    .detach();
+}
+
+fn record_save(buffer: &Entity<Buffer>, cx: &App) {
+    let Some(file) = buffer.read(cx).file().and_then(|file| file.as_local()) else {
+        return;
+    };
+    if let Some(history) = LocalHistory::global(cx) {
+        history.read(cx).record(file.abs_path(cx));
+    }
+}
+
+impl LocalHistory {
+    pub fn global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalLocalHistory>()
+            .map(|history| history.0.clone())
+    }
+
+    fn new(root: PathBuf, cx: &mut Context<Self>) -> Self {
+        let (requests, request_rx) = smol::channel::unbounded::<PathBuf>();
+        let (saved_tx, saved_rx) = smol::channel::unbounded::<PathBuf>();
+        // One worker takes the saves in order, so two saves never race on the same folder
+        // or on the running total.
+        let worker = cx.background_spawn({
+            let mut store = Store {
+                root: root.clone(),
+                total_size: None,
+            };
+            async move {
+                while let Ok(path) = request_rx.recv().await {
+                    match store.snapshot(&path) {
+                        Ok(true) => {
+                            if saved_tx.send(path).await.is_err() {
+                                break;
+                            }
+                        }
+                        Ok(false) => {}
+                        Err(error) => {
+                            log::error!("local history of {}: {error:#}", path.display())
+                        }
+                    }
+                }
+            }
+        });
+        let notifier = cx.spawn(async move |this, cx| {
+            while let Ok(path) = saved_rx.recv().await {
+                if this
+                    .update(cx, |_, cx| cx.emit(SnapshotSaved(path)))
+                    .is_err()
+                {
+                    break;
+                }
+            }
+        });
+        Self {
+            root,
+            requests,
+            _tasks: [worker, notifier],
+        }
+    }
+
+    fn record(&self, path: PathBuf) {
+        self.requests.try_send(path).log_err();
+    }
+
+    /// The saved versions of `path`, newest first.
+    pub fn entries(&self, path: &Path, cx: &App) -> Task<Vec<LocalHistoryEntry>> {
+        let folder = self.root.join(folder_name(path));
+        cx.background_spawn(async move {
+            let mut entries = read_entries(&folder)
+                .into_iter()
+                .map(|(saved_at, snapshot, _)| LocalHistoryEntry { saved_at, snapshot })
+                .collect::<Vec<_>>();
+            entries.reverse();
+            entries
+        })
+    }
+}
+
+struct Store {
+    root: PathBuf,
+    /// Bytes of all snapshots, counted on the first save of the session.
+    total_size: Option<u64>,
+}
+
+impl Store {
+    /// Keeps the saved contents of `path`. Returns whether a snapshot was added: files over
+    /// the size limit, or saved unchanged, add none.
+    fn snapshot(&mut self, path: &Path) -> Result<bool> {
+        let metadata = fs::metadata(path).context("reading the saved file")?;
+        if !metadata.is_file() || metadata.len() > MAX_FILE_SIZE {
+            return Ok(false);
+        }
+        let content = fs::read(path).context("reading the saved file")?;
+        let folder = self.root.join(folder_name(path));
+        let mut entries = read_entries(&folder);
+        if let Some((_, latest, _)) = entries.last()
+            && fs::read(latest).ok().as_deref() == Some(content.as_slice())
+        {
+            return Ok(false);
+        }
+        if entries.is_empty() {
+            fs::create_dir_all(&folder).context("creating the history folder")?;
+            fs::write(
+                folder.join(PATH_FILE_NAME),
+                path.to_string_lossy().as_bytes(),
+            )
+            .context("writing the history folder's path")?;
+        }
+
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_or(0, |since_epoch| since_epoch.as_millis() as i64);
+        // Two saves within a millisecond must not overwrite each other.
+        let saved_at = entries
+            .last()
+            .map_or(now, |(latest, _, _)| now.max(latest + 1));
+        fs::write(folder.join(saved_at.to_string()), &content).context("writing the snapshot")?;
+        let mut total_size = self.total_size(content.len() as u64);
+
+        let excess = (entries.len() + 1).saturating_sub(MAX_ENTRIES_PER_FILE);
+        for (_, snapshot, size) in entries.drain(..excess) {
+            if fs::remove_file(&snapshot).log_err().is_some() {
+                total_size = total_size.saturating_sub(size);
+            }
+        }
+        self.total_size = Some(total_size);
+        if total_size > MAX_TOTAL_SIZE {
+            self.trim();
+        }
+        Ok(true)
+    }
+
+    /// The running total after adding `added` bytes, counting what is already on disk the
+    /// first time.
+    fn total_size(&mut self, added: u64) -> u64 {
+        match self.total_size {
+            Some(total) => total + added,
+            None => self.all_entries().iter().map(|(_, _, size)| size).sum(),
+        }
+    }
+
+    /// Deletes the oldest snapshots, of any file, until the history is well under its limit,
+    /// so the next saves don't each trigger another pass.
+    fn trim(&mut self) {
+        let mut entries = self.all_entries();
+        entries.sort_by_key(|(saved_at, _, _)| *saved_at);
+        let mut total: u64 = entries.iter().map(|(_, _, size)| size).sum();
+        for (_, snapshot, size) in entries {
+            if total <= MAX_TOTAL_SIZE / 10 * 9 {
+                break;
+            }
+            if fs::remove_file(&snapshot).log_err().is_some() {
+                total = total.saturating_sub(size);
+                if let Some(folder) = snapshot.parent()
+                    && read_entries(folder).is_empty()
+                {
+                    fs::remove_dir_all(folder).log_err();
+                }
+            }
+        }
+        self.total_size = Some(total);
+    }
+
+    fn all_entries(&self) -> Vec<(i64, PathBuf, u64)> {
+        let Ok(folders) = fs::read_dir(&self.root) else {
+            return Vec::new();
+        };
+        folders
+            .flatten()
+            .flat_map(|folder| read_entries(&folder.path()))
+            .collect()
+    }
+}
+
+/// The snapshots in a file's history folder, oldest first, with their sizes.
+fn read_entries(folder: &Path) -> Vec<(i64, PathBuf, u64)> {
+    let Ok(children) = fs::read_dir(folder) else {
+        return Vec::new();
+    };
+    let mut entries = children
+        .flatten()
+        .filter_map(|child| {
+            let saved_at = child.file_name().to_str()?.parse::<i64>().ok()?;
+            let size = child.metadata().ok()?.len();
+            Some((saved_at, child.path(), size))
+        })
+        .collect::<Vec<_>>();
+    entries.sort_by_key(|(saved_at, _, _)| *saved_at);
+    entries
+}
+
+/// FNV-1a of the path: unlike std's hasher it is stable across Rust releases, so a file
+/// keeps its folder after an update.
+fn folder_name(path: &Path) -> String {
+    let hash = path
+        .to_string_lossy()
+        .bytes()
+        .fold(0xcbf29ce484222325_u64, |hash, byte| {
+            (hash ^ byte as u64).wrapping_mul(0x100000001b3)
+        });
+    format!("{hash:016x}")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_snapshots_are_bounded_and_deduplicated() {
+        let temp = tempfile::tempdir().unwrap();
+        let file = temp.path().join("file.txt");
+        let mut store = Store {
+            root: temp.path().join("history"),
+            total_size: None,
+        };
+
+        fs::write(&file, "one").unwrap();
+        assert!(store.snapshot(&file).unwrap());
+        assert!(
+            !store.snapshot(&file).unwrap(),
+            "unchanged saves add nothing"
+        );
+
+        for version in 0..MAX_ENTRIES_PER_FILE + 5 {
+            fs::write(&file, format!("version {version}")).unwrap();
+            assert!(store.snapshot(&file).unwrap());
+        }
+        let entries = read_entries(&store.root.join(folder_name(&file)));
+        assert_eq!(entries.len(), MAX_ENTRIES_PER_FILE);
+        assert_eq!(
+            fs::read_to_string(&entries.last().unwrap().1).unwrap(),
+            format!("version {}", MAX_ENTRIES_PER_FILE + 4)
+        );
+        let on_disk: u64 = entries.iter().map(|(_, _, size)| size).sum();
+        assert_eq!(store.total_size, Some(on_disk));
+    }
+}

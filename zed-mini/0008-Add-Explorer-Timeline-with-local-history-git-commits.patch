+//! The Timeline section of the Explorer, as in VS Code: the saved versions and the commits of
+//! the active file, newest first. Choosing one opens its diff against the file as it is now.
+
+mod local_history;
+
+use anyhow::{Context as _, Result, anyhow};
+use std::collections::HashMap;
+use git::repository::{CommitData, LogOrder, LogSource, RepoPath};
+use git_ui_core::file_diff_view::{FileDiffView, build_buffer_diff};
+use gpui::{
+    App, AppContext as _, Context, Entity, FocusHandle, Focusable, ScrollStrategy, Subscription,
+    Task, UniformListScrollHandle, WeakEntity, Window, uniform_list,
+};
+use language::{Buffer, Capability};
+use local_history::{LocalHistory, LocalHistoryEntry, SnapshotSaved};
+use project::{
+    Project, ProjectPath,
+    git_store::{
+        CommitDataState, GitStoreEvent, LocalRepositoryState, Repository, RepositoryEvent,
+        RepositoryState,
+    },
+};
+use project_panel::{ExplorerSection, ProjectPanel};
+use std::{cmp::Reverse, path::PathBuf, rc::Rc, sync::Arc, time::Duration};
+use time::OffsetDateTime;
+use time_format::TimestampFormat;
+use ui::{ListItem, ListItemSpacing, prelude::*};
+use workspace::{Workspace, notifications::DetachAndPromptErr as _};
+use zed_actions::timeline::{OpenTimeline, OpenTimelineForPath};
+
+const TITLE: &str = "Timeline";
+/// The timeline lists a file's most recent commits only, like the first page of VS Code's.
+const MAX_COMMITS: usize = 100;
+
+pub fn init(cx: &mut App) {
+    local_history::init(cx);
+}
+
+/// Adds the Timeline section to the workspace's project panel.
+pub fn add_to_explorer(
+    workspace: &mut Workspace,
+    project_panel: &Entity<ProjectPanel>,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) {
+    let timeline = cx.new(|cx| TimelineView::new(workspace, cx));
+    let focus_handle = timeline.focus_handle(cx);
+    let set_visible = {
+        let timeline = timeline.downgrade();
+        move |visible: bool, _: &mut Window, cx: &mut App| {
+            timeline
+                .update(cx, |timeline, cx| timeline.set_visible(visible, cx))
+                .ok();
+        }
+    };
+    workspace.register_action(|workspace, _: &OpenTimeline, window, cx| {
+        project_panel::focus_section(workspace, TITLE, window, cx);
+    });
+    workspace.register_action({
+        let timeline = timeline.downgrade();
+        move |workspace, action: &OpenTimelineForPath, window, cx| {
+            project_panel::focus_section(workspace, TITLE, window, cx);
+            let abs_path = action.abs_path.clone();
+            timeline
+                .update(cx, |timeline, cx| timeline.show_path(abs_path, cx))
+                .ok();
+        }
+    });
+    project_panel.update(cx, |project_panel, cx| {
+        project_panel.add_section(
+            ExplorerSection {
+                title: TITLE.into(),
+                view: timeline.into(),
+                focus_handle,
+                set_visible: Rc::new(set_visible),
+                expanded: false,
+            },
+            window,
+            cx,
+        )
+    });
+}
+
+struct ActiveFile {
+    project_path: ProjectPath,
+    abs_path: PathBuf,
+    name: SharedString,
+}
+
+enum TimelineEntry {
+    Saved(LocalHistoryEntry),
+    Commit(Arc<CommitData>),
+}
+
+impl TimelineEntry {
+    fn unix_seconds(&self) -> i64 {
+        match self {
+            TimelineEntry::Saved(entry) => entry.saved_at / 1000,
+            TimelineEntry::Commit(commit) => commit.commit_timestamp,
+        }
+    }
+}
+
+pub struct TimelineView {
+    workspace: WeakEntity<Workspace>,
+    project: Entity<Project>,
+    focus_handle: FocusHandle,
+    scroll_handle: UniformListScrollHandle,
+    visible: bool,
+    file: Option<ActiveFile>,
+    repository: Option<(Entity<Repository>, RepoPath)>,
+    saved: Vec<LocalHistoryEntry>,
+    loaded_commits: HashMap<git::Oid, Arc<CommitData>>,
+    entries: Vec<TimelineEntry>,
+    selected: Option<usize>,
+    // Held only while the section is on screen: a hidden timeline tracks nothing.
+    subscriptions: Vec<Subscription>,
+    repository_subscriptions: Vec<Subscription>,
+    load_saved: Task<()>,
+    rebuild_task: Option<Task<()>>,
+}
+
+impl TimelineView {
+    fn new(workspace: &Workspace, cx: &mut Context<Self>) -> Self {
+        Self {
+            workspace: workspace.weak_handle(),
+            project: workspace.project().clone(),
+            focus_handle: cx.focus_handle(),
+            scroll_handle: UniformListScrollHandle::new(),
+            visible: false,
+            file: None,
+            repository: None,
+            saved: Vec::new(),
+            loaded_commits: HashMap::default(),
+            entries: Vec::new(),
+            selected: None,
+            subscriptions: Vec::new(),
+            repository_subscriptions: Vec::new(),
+            load_saved: Task::ready(()),
+            rebuild_task: None,
+        }
+    }
+
+    fn set_visible(&mut self, visible: bool, cx: &mut Context<Self>) {
+        if self.visible == visible {
+            return;
+        }
+        self.visible = visible;
+        if visible {
+            if let Some(workspace) = self.workspace.upgrade() {
+                self.subscriptions.push(cx.subscribe(
+                    &workspace,
+                    |this, _, event: &workspace::Event, cx| {
+                        if matches!(event, workspace::Event::ActiveItemChanged) {
+                            this.update_active_file(cx);
+                        }
+                    },
+                ));
+            }
+            if let Some(history) = LocalHistory::global(cx) {
+                self.subscriptions.push(cx.subscribe(
+                    &history,
+                    |this, _, SnapshotSaved(path), cx| {
+                        if this
+                            .file
+                            .as_ref()
+                            .is_some_and(|file| &file.abs_path == path)
+                        {
+                            this.load_saved(cx);
+                        }
+                    },
+                ));
+            }
+            let git_store = self.project.read(cx).git_store().clone();
+            self.subscriptions.push(cx.subscribe(
+                &git_store,
+                |this, _, event: &GitStoreEvent, cx| {
+                    if matches!(
+                        event,
+                        GitStoreEvent::RepositoryAdded | GitStoreEvent::RepositoryRemoved(_)
+                    ) {
+                        this.refresh_repository(cx);
+                    }
+                },
+            ));
+            // The section can be shown from inside an update of the workspace (the project panel
+            // restoring it at startup), which update_active_file reads.
+            let this = cx.weak_entity();
+            cx.defer(move |cx| {
+                this.update(cx, |this, cx| this.update_active_file(cx)).ok();
+            });
+        } else {
+            self.subscriptions.clear();
+            self.repository_subscriptions.clear();
+            self.load_saved = Task::ready(());
+            self.rebuild_task = None;
+            self.file = None;
+            self.repository = None;
+            self.saved = Vec::new();
+            self.loaded_commits.clear();
+            self.entries = Vec::new();
+            self.selected = None;
+        }
+        cx.notify();
+    }
+
+    fn update_active_file(&mut self, cx: &mut Context<Self>) {
+        if !self.visible {
+            return;
+        }
+        let Some(workspace) = self.workspace.upgrade() else {
+            return;
+        };
+        // Items without a file, like the diffs this view opens, keep the last file's timeline.
+        let Some(project_path) = workspace
+            .read(cx)
+            .active_item(cx)
+            .and_then(|item| item.project_path(cx))
+        else {
+            return;
+        };
+        self.set_file(project_path, cx);
+    }
+
+    /// Shows the timeline of `abs_path` until the active editor changes, as VS Code's Open
+    /// Timeline does.
+    fn show_path(&mut self, abs_path: PathBuf, cx: &mut Context<Self>) {
+        // After the section's own deferred look at the active editor, which would replace it.
+        let this = cx.weak_entity();
+        cx.defer(move |cx| {
+            this.update(cx, |this, cx| {
+                if !this.visible {
+                    return;
+                }
+                if let Some(project_path) = this.project.read(cx).find_project_path(&abs_path, cx) {
+                    this.set_file(project_path, cx);
+                }
+            })
+            .ok();
+        });
+    }
+
+    fn set_file(&mut self, project_path: ProjectPath, cx: &mut Context<Self>) {
+        if self
+            .file
+            .as_ref()
+            .is_some_and(|file| file.project_path == project_path)
+        {
+            return;
+        }
+        let project = self.project.read(cx);
+        let Some(abs_path) = project.absolute_path(&project_path, cx) else {
+            return;
+        };
+        let name = project_path
+            .path
+            .file_name()
+            .unwrap_or_default()
+            .to_string()
+            .into();
+        self.bind_repository(&project_path, cx);
+        self.file = Some(ActiveFile {
+            project_path,
+            abs_path,
+            name,
+        });
+        self.saved = Vec::new();
+        self.loaded_commits.clear();
+        self.rebuild_task = None;
+        self.selected = None;
+        self.load_saved(cx);
+        self.rebuild(cx);
+    }
+
+    fn bind_repository(&mut self, project_path: &ProjectPath, cx: &mut Context<Self>) {
+        let next_repo = self
+            .project
+            .read(cx)
+            .git_store()
+            .read(cx)
+            .repository_and_path_for_project_path(project_path, cx);
+        self.repository_subscriptions = match &next_repo {
+            Some((repository, _)) => vec![
+                // Commit details arrive one by one, each notifying the repository; coalesce
+                // bursts so loading N commits does not trigger O(N^2) rebuilds.
+                cx.observe(repository, |this, _, cx| this.schedule_rebuild(cx)),
+                cx.subscribe(repository, |this, _, event: &RepositoryEvent, cx| {
+                    if matches!(
+                        event,
+                        RepositoryEvent::GraphEvent(..) | RepositoryEvent::HeadChanged
+                    ) {
+                        this.schedule_rebuild(cx);
+                    }
+                }),
+            ],
+            None => Vec::new(),
+        };
+        self.repository = next_repo;
+    }
+
+    fn refresh_repository(&mut self, cx: &mut Context<Self>) {
+        if !self.visible {
+            return;
+        }
+        let Some(project_path) = self.file.as_ref().map(|file| file.project_path.clone()) else {
+            return;
+        };
+        let next_repo = self
+            .project
+            .read(cx)
+            .git_store()
+            .read(cx)
+            .repository_and_path_for_project_path(&project_path, cx);
+        let unchanged = match (&self.repository, &next_repo) {
+            (Some((a, ap)), Some((b, bp))) => a.entity_id() == b.entity_id() && ap == bp,
+            (None, None) => true,
+            _ => false,
+        };
+        if unchanged {
+            return;
+        }
+        self.bind_repository(&project_path, cx);
+        self.loaded_commits.clear();
+        self.rebuild_task = None;
+        self.rebuild(cx);
+    }
+
+    fn schedule_rebuild(&mut self, cx: &mut Context<Self>) {
+        if self.rebuild_task.is_some() {
+            return;
+        }
+        self.rebuild_task = Some(cx.spawn(async move |this, cx| {
+            cx.background_executor()
+                .timer(Duration::from_millis(16))
+                .await;
+            this.update(cx, |this, cx| {
+                this.rebuild_task = None;
+                this.rebuild(cx);
+            })
+            .ok();
+        }));
+    }
+
+    fn load_saved(&mut self, cx: &mut Context<Self>) {
+        let (Some(file), Some(history)) = (&self.file, LocalHistory::global(cx)) else {
+            return;
+        };
+        let entries = history.read(cx).entries(&file.abs_path, cx);
+        self.load_saved = cx.spawn(async move |this, cx| {
+            let saved = entries.await;
+            this.update(cx, |this, cx| {
+                this.saved = saved;
+                this.rebuild(cx);
+            })
+            .ok();
+        });
+    }
+
+    /// Merges the saved versions with the commits whose details have arrived, newest first.
+    fn rebuild(&mut self, cx: &mut Context<Self>) {
+        let mut entries = self
+            .saved
+            .iter()
+            .cloned()
+            .map(TimelineEntry::Saved)
+            .collect::<Vec<_>>();
+        if let Some((repository, repo_path)) = &self.repository {
+            let log_source = LogSource::Path(repo_path.clone());
+            repository.update(cx, |repository, cx| {
+                let shas = repository
+                    .graph_data(log_source, LogOrder::DateOrder, 0..MAX_COMMITS, cx)
+                    .commits
+                    .iter()
+                    .map(|commit| commit.sha)
+                    .collect::<Vec<_>>();
+                for sha in shas {
+                    if let Some(commit) = self.loaded_commits.get(&sha) {
+                        entries.push(TimelineEntry::Commit(commit.clone()));
+                    } else if let CommitDataState::Loaded(commit) =
+                        repository.fetch_commit_data(sha, false, cx)
+                    {
+                        self.loaded_commits.insert(sha, commit.clone());
+                        entries.push(TimelineEntry::Commit(commit.clone()));
+                    }
+                }
+            });
+        }
+        entries.sort_by_key(|entry| Reverse(entry.unix_seconds()));
+        self.entries = entries;
+        cx.notify();
+    }
+
+    fn select_next(&mut self, _: &menu::SelectNext, _: &mut Window, cx: &mut Context<Self>) {
+        let next = self.selected.map_or(0, |selected| selected + 1);
+        if next < self.entries.len() {
+            self.select(next, cx);
+        }
+    }
+
+    fn select_previous(
+        &mut self,
+        _: &menu::SelectPrevious,
+        _: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if let Some(previous) = self.selected.and_then(|selected| selected.checked_sub(1)) {
+            self.select(previous, cx);
+        }
+    }
+
+    fn confirm(&mut self, _: &menu::Confirm, window: &mut Window, cx: &mut Context<Self>) {
+        if let Some(selected) = self.selected {
+            self.open_entry(selected, window, cx);
+        }
+    }
+
+    fn select(&mut self, index: usize, cx: &mut Context<Self>) {
+        self.selected = Some(index);
+        self.scroll_handle
+            .scroll_to_item(index, ScrollStrategy::Nearest);
+        cx.notify();
+    }
+
+    fn open_entry(&mut self, index: usize, window: &mut Window, cx: &mut Context<Self>) {
+        let (Some(entry), Some(file)) = (self.entries.get(index), self.file.as_ref()) else {
+            return;
+        };
+        let old_text: Task<Result<String>> = match entry {
+            TimelineEntry::Saved(saved) => {
+                let snapshot = saved.snapshot.clone();
+                cx.background_spawn(async move {
+                    let contents = std::fs::read(&snapshot).context("reading the saved version")?;
+                    Ok(String::from_utf8_lossy(&contents).into_owned())
+                })
+            }
+            TimelineEntry::Commit(commit) => {
+                let Some((repository, repo_path)) = self.repository.as_ref() else {
+                    return;
+                };
+                let commit_sha = commit.sha.to_string();
+                let repo_path = repo_path.clone();
+                let contents = repository.update(cx, |repository, _| {
+                    repository.send_job("timeline", None, move |state, _| async move {
+                        match state {
+                            RepositoryState::Local(LocalRepositoryState { backend, .. }) => {
+                                let direct = format!("{commit_sha}:{}", repo_path.as_unix_str());
+                                let loaded = backend
+                                    .load_revisions(vec![direct])
+                                    .await?
+                                    .into_iter()
+                                    .next()
+                                    .flatten();
+                                if loaded.is_some() {
+                                    return Ok(loaded);
+                                }
+                                // `git log --follow` includes commits from before the file was
+                                // renamed; resolve its historical path at `commit_sha`.
+                                if let Some(historical_path) =
+                                    backend.file_path_at_commit(&commit_sha, &repo_path).await?
+                                {
+                                    let historical = format!("{commit_sha}:{historical_path}");
+                                    return Ok(backend
+                                        .load_revisions(vec![historical])
+                                        .await?
+                                        .into_iter()
+                                        .next()
+                                        .flatten());
+                                }
+                                Ok(None)
+                            }
+                            RepositoryState::Remote(_) => Err(anyhow!(
+                                "the timeline can't read commits of remote projects"
+                            )),
+                        }
+                    })
+                });
+                cx.background_spawn(async move {
+                    let contents = contents.await??.context(
+                        "the file had another name, or did not exist, in that commit",
+                    )?;
+                    Ok(String::from_utf8_lossy(&contents).into_owned())
+                })
+            }
+        };
+        let title: SharedString = format!("{} ({})", file.name, relative_time(entry)).into();
+        let project_path = file.project_path.clone();
+        let project = self.project.clone();
+        let workspace = self.workspace.clone();
+        cx.spawn_in(window, async move |_, cx| {
+            let old_text = old_text.await?;
+            let new_buffer = project
+                .update(cx, |project, cx| project.open_buffer(project_path, cx))
+                .await?;
+            let old_buffer = cx.new(|cx| {
+                let mut buffer = Buffer::local(old_text, cx);
+                let new = new_buffer.read(cx);
+                if let Some(language_registry) = new.language_registry() {
+                    buffer.set_language_registry(language_registry);
+                }
+                buffer.set_language(new.language().cloned(), cx);
+                buffer.set_capability(Capability::ReadOnly, cx);
+                buffer
+            });
+            let diff = build_buffer_diff(&old_buffer, &new_buffer, cx).await?;
+            workspace.update_in(cx, |workspace, window, cx| {
+                let workspace_entity = cx.entity();
+                let diff_view = cx.new(|cx| {
+                    let mut diff_view = FileDiffView::new(
+                        old_buffer,
+                        new_buffer,
+                        diff,
+                        project,
+                        workspace_entity,
+                        window,
+                        cx,
+                    );
+                    diff_view.set_old_title(title, cx);
+                    diff_view
+                });
+                workspace.add_item_to_active_pane(Box::new(diff_view), None, true, window, cx);
+            })
+        })
+        .detach_and_prompt_err(
+            "Failed to open the timeline entry",
+            window,
+            cx,
+            |_, _, _| None,
+        );
+    }
+
+    fn render_entry(&self, index: usize, cx: &mut Context<Self>) -> AnyElement {
+        let Some(entry) = self.entries.get(index) else {
+            return div().into_any_element();
+        };
+        let (icon, label, description) = match entry {
+            TimelineEntry::Saved(_) => (IconName::Circle, SharedString::from("File Saved"), None),
+            TimelineEntry::Commit(commit) => (
+                IconName::GitCommit,
+                commit.subject.clone(),
+                Some(commit.author_name.clone()),
+            ),
+        };
+        ListItem::new(index)
+            .spacing(ListItemSpacing::ExtraDense)
+            .toggle_state(self.selected == Some(index))
+            .start_slot(Icon::new(icon).size(IconSize::Small).color(Color::Muted))
+            .child(
+                h_flex()
+                    .min_w_0()
+                    .gap_1p5()
+                    .child(Label::new(label).single_line().truncate())
+                    .children(description.map(|description| {
+                        Label::new(description)
+                            .size(LabelSize::Small)
+                            .color(Color::Muted)
+                            .single_line()
+                    })),
+            )
+            .end_slot(
+                Label::new(relative_time(entry))
+                    .size(LabelSize::Small)
+                    .color(Color::Muted)
+                    .single_line(),
+            )
+            .on_click(cx.listener(move |this, _, window, cx| {
+                this.select(index, cx);
+                this.open_entry(index, window, cx);
+            }))
+            .into_any_element()
+    }
+}
+
+fn relative_time(entry: &TimelineEntry) -> String {
+    let now = OffsetDateTime::now_utc();
+    let time = OffsetDateTime::from_unix_timestamp(entry.unix_seconds()).unwrap_or(now);
+    time_format::format_local_timestamp(time, now, TimestampFormat::Relative)
+}
+
+impl Focusable for TimelineView {
+    fn focus_handle(&self, _: &App) -> FocusHandle {
+        self.focus_handle.clone()
+    }
+}
+
+impl Render for TimelineView {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let message = if self.file.is_none() {
+            Some("The active editor cannot provide timeline information.")
+        } else if self.entries.is_empty() {
+            Some("No timeline information was provided.")
+        } else {
+            None
+        };
+        v_flex()
+            .id("timeline")
+            .key_context("Timeline")
+            .track_focus(&self.focus_handle)
+            .size_full()
+            .on_action(cx.listener(Self::select_next))
+            .on_action(cx.listener(Self::select_previous))
+            .on_action(cx.listener(Self::confirm))
+            .map(|this| match message {
+                Some(message) => this.child(
+                    div().px_3().py_1().child(
+                        Label::new(message)
+                            .color(Color::Muted)
+                            .size(LabelSize::Small),
+                    ),
+                ),
+                None => this.child(
+                    uniform_list(
+                        "timeline-entries",
+                        self.entries.len(),
+                        cx.processor(|this, range: std::ops::Range<usize>, _, cx| {
+                            range.map(|index| this.render_entry(index, cx)).collect()
+                        }),
+                    )
+                    .track_scroll(&self.scroll_handle)
+                    .size_full(),
+                ),
+            })
+    }
+}

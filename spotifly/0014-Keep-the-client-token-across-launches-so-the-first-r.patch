From 76e282dffec8a59bc1878d5e1971348d18a2aebf Mon Sep 17 00:00:00 2001
From: patched <patched@local>
Date: Thu, 26 Nov 2026 22:27:00 -0300
Subject: [PATCH 14/19] Keep the client token across launches, so the first
 requests do not wait for one

---
 Spotifly/Auth/ClientTokenProvider.swift  | 40 ++++++++++++------
 Spotifly/Auth/SpotifyCredentials.swift   |  6 ++-
 Spotifly/PartnerAPI/PathfinderHome.swift |  2 +-
 SpotiflyTests/ClientTokenTests.swift     | 53 +++++++++++++++++++-----
 4 files changed, 75 insertions(+), 26 deletions(-)

diff --git a/Spotifly/Auth/ClientTokenProvider.swift b/Spotifly/Auth/ClientTokenProvider.swift
index c878c4e..cb4cb27 100644
--- a/Spotifly/Auth/ClientTokenProvider.swift
+++ b/Spotifly/Auth/ClientTokenProvider.swift
@@ -8,7 +8,7 @@
 import Foundation
 
 /// A client token and how long it is good for.
-nonisolated struct GrantedClientToken: Sendable, Equatable {
+nonisolated struct GrantedClientToken: Sendable, Equatable, Codable {
     var token: String
     var expiresAt: Date
 }
@@ -45,15 +45,17 @@ actor ClientTokenProvider {
     typealias Fetcher = @Sendable (_ deviceId: String) async throws -> GrantedClientToken
 
     private let fetcher: Fetcher
-    private let deviceIdStore: DeviceIdStoring
-    private var cached: GrantedClientToken?
+    private let store: ClientTokenStoring
+    /// From the start, the token an earlier launch was granted: it lasts a fortnight, and a
+    /// launch that asked for a new one held its first requests for that round trip.
+    private lazy var cached: GrantedClientToken? = store.token()
     private var inFlight: Task<GrantedClientToken, Error>?
 
     init(
-        deviceIdStore: DeviceIdStoring = UserDefaultsDeviceIdStore(),
+        store: ClientTokenStoring = UserDefaultsClientTokenStore(),
         fetcher: @escaping Fetcher = { try await ClientTokenRequest.send(deviceId: $0) },
     ) {
-        self.deviceIdStore = deviceIdStore
+        self.store = store
         self.fetcher = fetcher
     }
 
@@ -69,13 +71,14 @@ actor ClientTokenProvider {
             return try await inFlight.value.token
         }
 
-        let deviceId = deviceIdStore.deviceId()
+        let deviceId = store.deviceId()
         let task = Task { [fetcher] in try await fetcher(deviceId) }
         inFlight = task
         defer { inFlight = nil }
 
         let granted = try await task.value
         cached = granted
+        store.save(granted)
         return granted.token
     }
 
@@ -90,19 +93,24 @@ actor ClientTokenProvider {
     func invalidate(rejected: String) {
         guard cached?.token == rejected else { return }
         cached = nil
+        store.save(nil)
     }
 }
 
-/// Where the device id lives. Stable across launches on purpose: it identifies this
-/// installation to Spotify, and a new one on every launch looks like a new device each time.
-nonisolated protocol DeviceIdStoring: Sendable {
+/// Where the device id and the token granted for it live. The id is stable across launches on
+/// purpose: it identifies this installation to Spotify, and a new one on every launch looks like
+/// a new device each time.
+nonisolated protocol ClientTokenStoring: Sendable {
     func deviceId() -> String
+    func token() -> GrantedClientToken?
+    func save(_ token: GrantedClientToken?)
 }
 
-/// Not a keychain item: it is an identifier, not a secret, and losing it costs nothing beyond
-/// looking like a fresh install.
-nonisolated struct UserDefaultsDeviceIdStore: DeviceIdStoring {
+/// Not the keychain: both name the installation, not the user, and losing them costs nothing
+/// beyond looking like a fresh install and one request, where a keychain read can wait on a prompt.
+nonisolated struct UserDefaultsClientTokenStore: ClientTokenStoring {
     private static let key = "keymasterDeviceId"
+    private static let tokenKey = "clientToken"
 
     func deviceId() -> String {
         if let existing = UserDefaults.standard.string(forKey: Self.key),
@@ -117,6 +125,14 @@ nonisolated struct UserDefaultsDeviceIdStore: DeviceIdStoring {
         return generated
     }
 
+    func token() -> GrantedClientToken? {
+        UserDefaults.standard.data(forKey: Self.tokenKey).flatMap { try? PropertyListDecoder().decode(GrantedClientToken.self, from: $0) }
+    }
+
+    func save(_ token: GrantedClientToken?) {
+        UserDefaults.standard.set(token.flatMap { try? PropertyListEncoder().encode($0) }, forKey: Self.tokenKey)
+    }
+
     /// 40 hex characters, matching what the desktop client sends.
     static func generate() -> String {
         var bytes = [UInt8](repeating: 0, count: 20)

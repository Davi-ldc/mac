diff --git a/SpotiflyTests/ClientTokenTests.swift b/SpotiflyTests/ClientTokenTests.swift
index 58d94dc..88888c5 100644
--- a/SpotiflyTests/ClientTokenTests.swift
+++ b/SpotiflyTests/ClientTokenTests.swift
@@ -150,10 +150,25 @@ struct ClientTokenRequestTests {
     }
 }
 
-private struct FixedDeviceIdStore: DeviceIdStoring {
-    let id: String
+/// A fixed device id, and the token as a launch would leave it for the next.
+private final class MemoryStore: ClientTokenStoring, @unchecked Sendable {
+    private let lock = NSLock()
+    private var saved: GrantedClientToken?
+
+    init(saved: GrantedClientToken? = nil) {
+        self.saved = saved
+    }
+
     func deviceId() -> String {
-        id
+        "0123456789abcdef0123456789abcdef01234567"
+    }
+
+    func token() -> GrantedClientToken? {
+        lock.withLock { saved }
+    }
+
+    func save(_ token: GrantedClientToken?) {
+        lock.withLock { saved = token }
     }
 }
 

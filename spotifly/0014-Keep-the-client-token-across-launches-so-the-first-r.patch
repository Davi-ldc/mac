     }
 
+    /// The token an earlier launch was granted serves the first requests, which no longer wait
+    /// for a new one; once refused, the next launch does not start with it either.
+    @Test func `a token from an earlier launch is used while it lasts, and forgotten once refused`() async throws {
+        let counter = FetchCounter()
+        let store = MemoryStore(saved: GrantedClientToken(token: "earlier", expiresAt: now.addingTimeInterval(3600)))
+        let provider = ClientTokenProvider(store: store, fetcher: { _ in counter.fetch(expiresAt: .distantFuture) })
+
+        #expect(try await provider.token(now: now) == "earlier")
+        #expect(counter.calls == 0)
+
+        await provider.invalidate(rejected: "earlier")
+        #expect(store.token() == nil)
+        #expect(try await provider.token(now: now) == "ct-1")
+        #expect(store.token()?.token == "ct-1")
+    }
+
     @Test func `concurrent callers share one fetch`() async throws {
         let counter = FetchCounter()
         let expiry = now.addingTimeInterval(3600)
-        let provider = ClientTokenProvider(deviceIdStore: store, fetcher: { _ in counter.fetch(expiresAt: expiry) })
+        let provider = ClientTokenProvider(store: store, fetcher: { _ in counter.fetch(expiresAt: expiry) })
         let asOf = now
 
         let tokens = try await withThrowingTaskGroup(of: String.self) { group in

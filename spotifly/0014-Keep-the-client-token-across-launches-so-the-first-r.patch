+        async let client = clientToken()
+        try await request.setValue("Bearer \(bearer)", forHTTPHeaderField: "Authorization")
+        try await request.setValue(client, forHTTPHeaderField: "Client-Token")
     }
 
     /// The app's own: the signed-in account's bearer and the shared client token, over the
diff --git a/Spotifly/PartnerAPI/PathfinderHome.swift b/Spotifly/PartnerAPI/PathfinderHome.swift

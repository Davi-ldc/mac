+/// Focuses `window`'s toolbar search field with all of its text selected, so typing replaces the
+/// last search. Returns false for a window without one: Settings, or the mini player.
+@discardableResult
+func focusSearchField(in window: NSWindow) -> Bool {
+    // The toolbar lives in the window frame view, above contentView.
+    guard let field = firstSearchField(in: window.contentView?.superview ?? window.contentView) else { return false }
+    field.selectText(nil)
+    return true
+}
+
+/// Focuses the search field on ⌘L or ⌘K, as Spotify's own app does (⌘L, and ⌘K for its quick
+/// search), beside the menu's ⌘F, from anywhere in a window that has the field. Returns whether
+/// the key was taken; in a sheet or alert it is left to them.
+func focusSearchOnShortcut(_ event: NSEvent) -> Bool {
+    let modifiers = event.modifierFlags.intersection(.deviceIndependentFlagsMask).subtracting([.capsLock, .function])
+    guard modifiers == .command, let key = event.charactersIgnoringModifiers?.lowercased(), ["l", "k"].contains(key),
+          let window = event.window, window.attachedSheet == nil, window.sheetParent == nil
+    else { return false }
+    return focusSearchField(in: window)
+}
+
 /// Ends the search field's editing on a click anywhere else in its window.
 ///
 /// SwiftUI's lists and grids take no focus when clicked, so once the toolbar's field had it, from

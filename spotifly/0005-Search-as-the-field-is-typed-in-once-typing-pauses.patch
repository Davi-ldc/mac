diff --git a/Spotifly/Store/Services/SearchService.swift b/Spotifly/Store/Services/SearchService.swift
index 7cc7d9d..88a84b8 100644
--- a/Spotifly/Store/Services/SearchService.swift
+++ b/Spotifly/Store/Services/SearchService.swift
@@ -37,22 +37,43 @@ final class SearchService {
 
     // MARK: - Search
 
+    /// The query of the newest search while it runs, which typing does not ask for again.
+    private(set) var searchingQuery: String?
+    /// Counts the searches asked for, so one can tell whether a newer one came after it.
+    private var searchRun = 0
+
+    /// Searches `query` and keeps its results, or why it failed, and with `remembering` the query
+    /// among the recent searches. Returns whether it kept them: not when a newer search was asked
+    /// for while it ran, nor when its caller was cancelled, as typing on cancels the last pause's,
+    /// so an older search never replaces a newer one.
+    ///
     /// Takes no access token: the partner API authorizes itself from the keymaster grant, which
     /// is the point of the migration. The Web API token this used to need was minted with the
     /// user's dashboard client id, and `api-partner` rejects it.
-    func search(query: String) async {
-        guard !query.isEmpty, !store.searchIsLoading else { return }
-
-        store.searchIsLoading = true
+    @discardableResult
+    func search(query: String, remembering: Bool = true) async -> Bool {
+        guard !query.isEmpty else { return false }
+        searchRun &+= 1
+        let run = searchRun
+        searchingQuery = query
+        defer {
+            if run == searchRun {
+                searchingQuery = nil
+            }
+        }
 
         do {
-            try await store.setSearchResults(partnerSearch(query: query), for: query)
-            remember(query)
+            let results = try await partnerSearch(query: query)
+            guard run == searchRun, !Task.isCancelled else { return false }
+            store.setSearchResults(results, for: query)
+            if remembering {
+                remember(query)
+            }
         } catch {
+            guard run == searchRun, !Task.isCancelled else { return false }
             store.setSearchFailure(error, for: query)
         }
-
-        store.searchIsLoading = false
+        return true
     }
 
     // MARK: - More results
@@ -103,7 +124,7 @@ final class SearchService {
     // MARK: - Recent searches
 
     /// Puts `query` first among the recent searches, once.
-    private func remember(_ query: String) {
+    func remember(_ query: String) {
         recentSearches.removeAll { $0 == query }
         recentSearches.insert(query, at: 0)
         recentSearches = Array(recentSearches.prefix(Self.recentSearchesLimit))
diff --git a/Spotifly/ViewModels/NavigationCoordinator.swift b/Spotifly/ViewModels/NavigationCoordinator.swift

--- a/Spotifly/ViewModels/NavigationCoordinator.swift
+++ b/Spotifly/ViewModels/NavigationCoordinator.swift
@@ -131,6 +131,20 @@ final class NavigationCoordinator {
         navigate(to: Route(section: .searchResults, query: query))
     }
 
+    /// Shows `query`'s results as it is typed: in place of the search shown, in the scope it is
+    /// shown in, so the history keeps one step for what was typed, as for a search with Return.
+    /// From anywhere else, the search home among it, a step of its own.
+    func showTypedSearch(query: String) {
+        guard store?.canShowSearch(for: query) == true else { return }
+        guard displayedSearchQuery != nil else {
+            navigate(to: Route(section: .searchResults, query: query))
+            return
+        }
+        var route = current
+        route.query = query
+        replace(with: route)
+    }
+
     func selectAlbum(_ albumId: String?, recordsHistory: Bool = true) {
         setSelection(albumId.map { .album(id: $0) }, for: .albums, recordsHistory: recordsHistory)
     }

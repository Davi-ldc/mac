+    /// What was typed is one step, so Back leads to where the search started, here the search
+    /// home, rather than through every pause in the typing.
+    @Test func `a typed search replaces the search shown`() {
+        let store = AppStore()
+        for query in ["g", "ga"] {
+            store.setSearchResults(emptySearchResults, for: query)
+        }
+        let coordinator = NavigationCoordinator(store: store)
+        coordinator.selectNavigationItem(.searchResults)
+
+        coordinator.showTypedSearch(query: "g")
+        coordinator.showTypedSearch(query: "ga")
+
+        #expect(coordinator.current == Route(section: .searchResults, query: "ga"))
+        coordinator.navigateBackward()
+        #expect(coordinator.current == Route(section: .searchResults))
+    }
+
+    @Test func `a typed search keeps the scope shown`() {
+        let store = AppStore()
+        for query in ["g", "ga"] {
+            store.setSearchResults(emptySearchResults, for: query)
+        }
+        let coordinator = NavigationCoordinator(store: store)
+        coordinator.navigateToSearchResults(query: "g")
+        coordinator.showSearchScope(.tracks)
+
+        coordinator.showTypedSearch(query: "ga")
+
+        #expect(coordinator.current == Route(section: .searchResults, query: "ga", searchScope: .tracks))
+    }
+
     @Test func `queue deep link applies its route directly`() {
         let coordinator = NavigationCoordinator(store: AppStore())
         coordinator.navigateToQueue()
diff --git a/SpotiflyTests/SearchServiceTests.swift b/SpotiflyTests/SearchServiceTests.swift
new file mode 100644
index 0000000..3847614
--- /dev/null
+++ b/SpotiflyTests/SearchServiceTests.swift
@@ -0,0 +1,74 @@
+//
+//  SearchServiceTests.swift
+//  SpotiflyTests
+//
+//  Searching as the field is typed in: the newest search is the one whose results are kept, and
+//  typing does not fill the recent searches.
+//
+
+import Foundation
+@testable import Spotifly
+import Testing
+
+@MainActor
+struct SearchServiceTests {
+    private let store = AppStore()
+
+    /// A service whose searches Spotify answers at once with no results, except those for
+    /// `held`, which wait for `gate` and then, as `URLSession` does, throw if cancelled.
+    private func service(holding held: String? = nil, until gate: AsyncGate? = nil) -> SearchService {
+        let transport: PartnerAPI.Transport = { request in
+            let body = String(decoding: request.httpBody ?? Data(), as: UTF8.self)
+            if let held, let gate, body.contains(#""searchTerm":"\#(held)""#) {
+                await gate.entered()
+                await gate.wait()
+                try Task.checkCancellation()
+            }
+            return (Data(#"{"data":{}}"#.utf8), httpResponse(200))
+        }
+        let defaults = UserDefaults(suiteName: "SearchServiceTests.\(UUID().uuidString)")!
+        return SearchService(store: store, partner: partnerAPI(transport: transport), defaults: defaults)
+    }
+
+    @Test func `an older search answering after a newer one keeps nothing`() async {
+        let gate = AsyncGate()
+        let search = service(holding: "gar", until: gate)
+        let older = Task { await search.search(query: "gar") }
+        await gate.waitUntilEntered()
+
+        #expect(await search.search(query: "garden"))
+        await gate.open()
+
+        #expect(await older.value == false)
+        #expect(store.searchResults(for: "gar") == nil)
+        #expect(store.searchResults(for: "garden") != nil)
+        #expect(search.recentSearches == ["garden"])
+        #expect(search.searchingQuery == nil)
+    }
+
+    /// Typing on cancels the search the last pause started.
+    @Test func `a cancelled search keeps no results and no failure`() async {
+        let gate = AsyncGate()
+        let search = service(holding: "gar", until: gate)
+        let typed = Task { await search.search(query: "gar", remembering: false) }
+        await gate.waitUntilEntered()
+        #expect(search.searchingQuery == "gar")
+
+        typed.cancel()
+        await gate.open()
+
+        #expect(await typed.value == false)
+        #expect(store.searchResults(for: "gar") == nil)
+        #expect(store.searchFailure(for: "gar") == nil)
+    }
+
+    /// A pause mid-word would otherwise add a part of a word.
+    @Test func `a typed search is not a recent search, one with Return is`() async {
+        let search = service()
+
+        #expect(await search.search(query: "gar", remembering: false))
+        #expect(search.recentSearches.isEmpty)
+        #expect(await search.search(query: "garden"))
+        #expect(search.recentSearches == ["garden"])
+    }
+}

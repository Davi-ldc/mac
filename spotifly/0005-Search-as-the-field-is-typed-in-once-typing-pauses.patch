                 .onChange(of: navigationCoordinator.displayedSearchQuery) { _, query in
@@ -210,21 +212,49 @@ struct LoggedInView: View {
         navigationCoordinator.selectedNavigationItem == .favorites
     }
 
+    /// Return: searches what the field says at once, and keeps it among the recent searches.
+    /// Results the typing already shows are kept, not asked for again.
     private func performSearch() {
         let query = searchText
+        if query == navigationCoordinator.displayedSearchQuery, session.store.searchResults(for: query) != nil {
+            session.searchService.remember(query)
+            return
+        }
         Task {
             debugLog("Search", "Starting search for: \(query)")
-            await session.searchService.search(query: query)
+            let kept = await session.searchService.search(query: query)
             debugLog("Search", "After search - results: \(session.store.searchResults(for: query) != nil), error: \(session.store.failedSearch?.failure.message ?? "nil")")
-            // The page opens for a failure too, to say so. The field can be cleared while the
-            // request is in flight, which already left the results view; do not navigate back
-            // into it behind the user.
-            if !searchText.isEmpty {
+            // The page opens for a failure too, to say so. Not for a search a newer one replaced,
+            // nor once the field says something else: typed on, or emptied, which already left
+            // the results view; do not navigate back into it behind the user.
+            if kept, searchText == query {
                 navigationCoordinator.navigateToSearchResults(query: query)
             }
         }
     }
 
+    /// Shows the results for what the field says once typing pauses for 250 ms, as Spotify's own
+    /// app searches as you type. The pause keeps a word typed at speed to one search of four
+    /// requests, against Spotify's rate limit. Nothing is asked for a query with results kept,
+    /// one already being searched, or the one on screen, which Back and a recent search put in
+    /// the field too. Typed queries are not recent searches: a pause mid-word would add one.
+    private func searchAsTyped() async {
+        let query = searchText
+        guard !isFilteringFavorites, !query.trimmingCharacters(in: .whitespaces).isEmpty,
+              query != navigationCoordinator.displayedSearchQuery
+        else { return }
+        do {
+            try await Task.sleep(for: .milliseconds(250))
+        } catch {
+            return
+        }
+        let search = session.searchService
+        if session.store.searchResults(for: query) == nil, search.searchingQuery != query {
+            guard await search.search(query: query, remembering: false) else { return }
+        }
+        navigationCoordinator.showTypedSearch(query: query)
+    }
+
     private func handleSearchTextChange(_ newValue: String) {
         guard newValue.isEmpty else { return }
         session.searchService.clearFailure()

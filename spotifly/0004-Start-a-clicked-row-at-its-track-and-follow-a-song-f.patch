+    /// the context does not list, plays another song. Named by its uri alone, the clicked track
+    /// plays; Soloist plays it first when an album or playlist does not list it.
     func play(uri: String, trackIndex: Int? = nil, startingAtUri: String? = nil) async {
         // A track or a context alike: `ConnectCommand.Context` tells them apart.
-        await start(.play(uri: uri, trackIndex: trackIndex, trackUri: startingAtUri))
+        await start(.play(uri: uri, trackIndex: startingAtUri == nil ? trackIndex : nil, trackUri: startingAtUri))
     }
 
     /// Plays a context shuffled, as the pages' Zufällig buttons do: shuffle on, then the context
@@ -463,11 +474,42 @@ final class PlaybackViewModel {
     }
 
     func playTracks(_ trackUris: [String]) async {
-        // The one caller disables its button on an empty list, so this only guards `[0]`.
         guard !trackUris.isEmpty else { return }
         await start(.play(trackUris: trackUris))
     }
 
+    /// Plays a song that has no list to go on in, as a search result: the song, then Spotify's
+    /// recommendations for it, its radio's tracks, as Spotify's app goes on after a song from
+    /// search. Without them, as when the radio cannot be had, `otherwise` follows.
+    ///
+    /// The radio goes as tracks after the song in one list, not as the station itself: played as
+    /// a context, a station need not start with its song, and Soloist starts nothing for a
+    /// skip_to it cannot find in one. Its first page, one request of 50 tracks, is fetched
+    /// before the play.
+    func playWithRecommendations(trackUri: String, otherwise: [String]) async {
+        playsAsked &+= 1
+        let asked = playsAsked
+        await initializeIfNeeded()
+        var radio: [String] = []
+        if let trackId = SpotifyURI.trackId(from: trackUri), let from = commandSource {
+            do {
+                radio = try await SpclientAPI().resolveContext("spotify:station:track:\(trackId)", deviceId: from, pages: 1).tracks
+            } catch {
+                debugLog("PlaybackViewModel", "No radio for \(trackUri), the search's songs follow: \(error)")
+            }
+        }
+        // Another play asked for while the radio loaded is the one wanted now.
+        guard playsAsked == asked else { return }
+        await playTracks(Self.track(trackUri, thenRecommendations: radio, otherwise: otherwise))
+    }
+
+    /// The song first, then the recommendations without it, as its radio can list it, or
+    /// `otherwise` where there are none.
+    nonisolated static func track(_ trackUri: String, thenRecommendations radio: [String], otherwise: [String]) -> [String] {
+        let after = radio.filter { $0 != trackUri }
+        return [trackUri] + (after.isEmpty ? otherwise.filter { $0 != trackUri } : after)
+    }
+
     /// Starts song radio: the track's station, a context like any other, played wherever `play`
     /// plays. Spotify's Soloist took it over connect-state on 2026-11-19.
     func playRadio(trackUri: String) async {

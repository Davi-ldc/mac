diff --git a/SpotiflyTests/SearchResultsTests.swift b/SpotiflyTests/SearchResultsTests.swift
index 3329d41..b349b6e 100644
--- a/SpotiflyTests/SearchResultsTests.swift
+++ b/SpotiflyTests/SearchResultsTests.swift
@@ -48,4 +48,32 @@ struct SearchResultsTests {
         #expect(results.playlistIds == ["p"])
         #expect(results.trackIds == ["t", "u"])
     }
+
+    /// The clicked song is the list's first, so it is the one that plays, whatever Spotify would
+    /// have put first in a context of its own.
+    @Test func `a clicked song plays first, then the songs found after it`() {
+        let results = SearchResults(albums: [], artists: [], playlists: [], tracks: ["a", "b", "c", "d"].map(track(id:)))
+
+        #expect(results.trackIds(playedFrom: "b") == ["b", "c", "d"])
+        #expect(results.trackIds(playedFrom: "d") == ["d"])
+    }
+
+    /// As Spotify's app goes on after a song from search. The radio can list the song itself,
+    /// which would play it twice.
+    @Test func `a clicked song plays first, then its recommendations without it`() {
+        let list = PlaybackViewModel.track(
+            "spotify:track:b",
+            thenRecommendations: ["spotify:track:r1", "spotify:track:b", "spotify:track:r2"],
+            otherwise: ["spotify:track:c"],
+        )
+
+        #expect(list == ["spotify:track:b", "spotify:track:r1", "spotify:track:r2"])
+    }
+
+    /// Something always follows the song, never nothing.
+    @Test func `without recommendations, the songs found after it follow`() {
+        let list = PlaybackViewModel.track("spotify:track:b", thenRecommendations: [], otherwise: ["spotify:track:c", "spotify:track:d"])
+
+        #expect(list == ["spotify:track:b", "spotify:track:c", "spotify:track:d"])
+    }
 }

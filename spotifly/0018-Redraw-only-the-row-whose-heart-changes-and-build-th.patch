             RoundedRectangle(cornerRadius: 10)
                 .fill(LinearGradient(
                     colors: [Color(red: 1, green: 0.56, blue: 0.64), Color(red: 0.88, green: 0.14, blue: 0.37)],
diff --git a/SpotiflyTests/SpotiflyTests.swift b/SpotiflyTests/SpotiflyTests.swift
index 1421299..84670ef 100644
--- a/SpotiflyTests/SpotiflyTests.swift
+++ b/SpotiflyTests/SpotiflyTests.swift
@@ -5,7 +5,9 @@
 //  Created by Ralph von der Heyden on 30.12.25.
 //
 
+import Observation
 @testable import Spotifly
+import Synchronization
 import Testing
 
 @MainActor
@@ -73,4 +75,22 @@ struct SpotiflyTests {
 
         #expect(store.savedTrackIds == ["a", "b", "c"])
     }
+
+    /// A row observes its own track's heart: toggling another redraws only that one, and a page
+    /// marking again a favorite already marked redraws none.
+    @Test func `a favorite toggled tells only the row of its track`() {
+        let store = AppStore()
+        store.markTracksAsFavorite(["a"])
+        let told = Mutex(false)
+        withObservationTracking { _ = store.isFavorite("a") } onChange: { told.withLock { $0 = true } }
+
+        store.addTrackToFavorites("b")
+        store.removeTrackFromFavorites("b")
+        store.markTracksAsFavorite(["a"])
+        #expect(!told.withLock { $0 })
+
+        store.removeTrackFromFavorites("a")
+        #expect(told.withLock { $0 })
+        #expect(!store.isFavorite("a"))
+    }
 }

From c20c3da93255f1bc7ad4f6f2669319e1d2f627f7 Mon Sep 17 00:00:00 2001
From: patched <patched@local>
Date: Thu, 26 Nov 2026 15:24:44 -0300
Subject: [PATCH 18/19] Redraw only the row whose heart changes, and build the
 favorites list once per redraw

---
 Spotifly/Store/AppStore.swift              | 45 ++++++++++++++++------
 Spotifly/Views/Components/TrackTable.swift |  5 ++-
 Spotifly/Views/FavoritesListView.swift     | 21 +++++-----
 SpotiflyTests/SpotiflyTests.swift          | 20 ++++++++++
 4 files changed, 67 insertions(+), 24 deletions(-)

diff --git a/Spotifly/Store/AppStore.swift b/Spotifly/Store/AppStore.swift
index 0b0764d..52ed221 100644
--- a/Spotifly/Store/AppStore.swift
+++ b/Spotifly/Store/AppStore.swift
@@ -44,8 +44,15 @@ final class AppStore {
     /// User's followed artist IDs in display order
     private(set) var userArtistIds: [String] = []
 
-    /// User's favorite track IDs (Set for O(1) lookup)
-    private(set) var favoriteTrackIds: Set<String> = []
+    /// Whether each track is a favorite, one observable per track: a row reads its own, so a
+    /// heart toggled redraws that row rather than every row that read a shared set. Made on its
+    /// first read, so that a track not yet a favorite is observed for when it becomes one.
+    @ObservationIgnored private var favorites: [String: Favorite] = [:]
+
+    @Observable
+    fileprivate final class Favorite {
+        var isFavorite = false
+    }
 
     /// Track IDs whose favorite status has been resolved from the Web API
     private(set) var resolvedFavoriteTrackIds: Set<String> = []
@@ -145,7 +152,25 @@ final class AppStore {
 
     /// Check if a track is favorited
     func isFavorite(_ trackId: String) -> Bool {
-        favoriteTrackIds.contains(trackId)
+        favorite(trackId).isFavorite
+    }
+
+    private func favorite(_ trackId: String) -> Favorite {
+        if let favorite = favorites[trackId] {
+            return favorite
+        }
+        let favorite = Favorite()
+        favorites[trackId] = favorite
+        return favorite
+    }
+
+    /// Only a change is written: a page of favorites marks again tracks already marked, and an
+    /// observable is told of every write, equal or not.
+    private func setFavorite(_ trackId: String, _ isFavorite: Bool) {
+        let favorite = favorite(trackId)
+        if favorite.isFavorite != isFavorite {
+            favorite.isFavorite = isFavorite
+        }
     }
 
     /// Check if a track's favorite status has already been resolved
@@ -401,7 +426,7 @@ final class AppStore {
 
     /// Add track to favorites (optimistic update)
     func addTrackToFavorites(_ trackId: String) {
-        favoriteTrackIds.insert(trackId)
+        setFavorite(trackId, true)
         resolvedFavoriteTrackIds.insert(trackId)
         if !savedTrackIds.contains(trackId) {
             savedTrackIds.insert(trackId, at: 0)
@@ -412,7 +437,7 @@ final class AppStore {
 
     /// Remove track from favorites (optimistic update)
     func removeTrackFromFavorites(_ trackId: String) {
-        favoriteTrackIds.remove(trackId)
+        setFavorite(trackId, false)
         resolvedFavoriteTrackIds.insert(trackId)
         savedTrackIds.removeAll { $0 == trackId }
         favoriteAddedAt[trackId] = nil
@@ -422,11 +447,7 @@ final class AppStore {
     func updateFavoriteStatuses(_ statuses: [String: Bool]) {
         for (trackId, isFavorite) in statuses {
             resolvedFavoriteTrackIds.insert(trackId)
-            if isFavorite {
-                favoriteTrackIds.insert(trackId)
-            } else {
-                favoriteTrackIds.remove(trackId)
-            }
+            setFavorite(trackId, isFavorite)
         }
     }
 
@@ -434,7 +455,7 @@ final class AppStore {
     func markTracksAsFavorite(_ trackIds: [String]) {
         for trackId in trackIds {
             resolvedFavoriteTrackIds.insert(trackId)
-            favoriteTrackIds.insert(trackId)
+            setFavorite(trackId, true)
         }
     }
 
@@ -652,7 +673,7 @@ final class AppStore {
                 userPlaylistIds: userPlaylistIds,
                 userAlbumIds: userAlbumIds,
                 userArtistIds: userArtistIds,
-                favoriteTrackIds: Array(favoriteTrackIds),
+                favoriteTrackIds: favorites.filter(\.value.isFavorite).map(\.key),
                 savedTrackIds: savedTrackIds,
                 playlistsPagination: playlistsPagination,
                 albumsPagination: albumsPagination,
diff --git a/Spotifly/Views/Components/TrackTable.swift b/Spotifly/Views/Components/TrackTable.swift
index a2150ea..6f6cddb 100644
--- a/Spotifly/Views/Components/TrackTable.swift
+++ b/Spotifly/Views/Components/TrackTable.swift
@@ -188,8 +188,9 @@ struct TrackTable: View {
         }
         .playerBarClearance()
         // One check for every row's heart, rather than one per row as it scrolls in; again when
-        // the rows change, which a queue does at the same count.
-        .task(id: rows.map(\.track.id)) {
+        // the rows change, which a queue does at the same count. Keyed by a hash of the ids
+        // rather than by an array of them, which every redraw would allocate and compare.
+        .task(id: rows.reduce(into: Hasher()) { $0.combine($1.track.id) }.finalize()) {
             await trackService.ensureFavoriteStatuses(trackIds: rows.map(\.track.id))
         }
         .newPlaylistPrompt(

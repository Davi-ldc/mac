 }
 
+/// Plays or pauses on a plain Space wherever the focus is not on editable text, as Spotify's own
+/// app does. The Playback menu's Space alone does not: a focused list keeps the key from it, and
+/// the sidebar has the focus from launch.
+///
+/// Returns whether the Space was taken. Held down, it is taken without repeating the toggle; in a
+/// sheet or alert it is left to the buttons there.
+func playPauseOnSpace(_ event: NSEvent) -> Bool {
+    let modifiers = event.modifierFlags.intersection(.deviceIndependentFlagsMask).subtracting([.capsLock, .function])
+    guard event.keyCode == 49, modifiers.isEmpty,
+          let window = event.window, window.attachedSheet == nil, window.sheetParent == nil
+    else { return false }
+    if let text = window.firstResponder as? NSText, text.isEditable {
+        return false
+    }
+    if !event.isARepeat {
+        let playback = PlaybackViewModel.shared
+        if playback.isPlaying {
+            playback.pause()
+        } else {
+            playback.resume()
+        }
+    }
+    return true
+}

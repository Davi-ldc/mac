Subject: [PATCH 11/11] Ask for the Soloist key only until it is set up, or
 while Soloist has failed

---
 Spotifly/Soloist/SoloistEngine.swift  | 11 +++++++++
 Spotifly/Views/PreferencesView.swift  | 34 ++++++---------------------
 Spotifly/de.lproj/Localizable.strings |  2 --
 Spotifly/en.lproj/Localizable.strings |  2 --
 Spotifly/fr.lproj/Localizable.strings |  2 --
 SpotiflyTests/SoloistTests.swift      | 13 ++++++++++
 6 files changed, 31 insertions(+), 33 deletions(-)

diff --git a/Spotifly/Soloist/SoloistEngine.swift b/Spotifly/Soloist/SoloistEngine.swift
index 62ff787..cf088b1 100644
--- a/Spotifly/Soloist/SoloistEngine.swift
+++ b/Spotifly/Soloist/SoloistEngine.swift
@@ -138,6 +138,17 @@ final class SoloistEngine {
         await start()
     }
 
+    /// Whether Settings asks for the key: until Soloist is set up, and while it has failed. Its
+    /// errors ask for the key again (`soloist.error.no_key`, `.keeps_stopping`), and entering it
+    /// is what starts over a Soloist whose first download failed. A key that works is not shown.
+    static func asksForKey(isSetUp: Bool, status: Status) -> Bool {
+        guard isSetUp else { return true }
+        if case .failed = status {
+            return true
+        }
+        return false
+    }
+
     /// Starts Soloist if it is set up and not running: installs or renews the build first.
     func start() async {
         guard Self.isSetUp, process == nil, !isStarting else { return }
diff --git a/Spotifly/Views/PreferencesView.swift b/Spotifly/Views/PreferencesView.swift
index d34c5ce..9cd9e5b 100644
--- a/Spotifly/Views/PreferencesView.swift
+++ b/Spotifly/Views/PreferencesView.swift
@@ -81,47 +81,33 @@ private struct PlaybackSettingsView: View {

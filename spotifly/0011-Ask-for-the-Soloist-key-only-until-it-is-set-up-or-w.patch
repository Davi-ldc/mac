diff --git a/SpotiflyTests/SoloistTests.swift b/SpotiflyTests/SoloistTests.swift
index 4b22199..f894e0b 100644
--- a/SpotiflyTests/SoloistTests.swift
+++ b/SpotiflyTests/SoloistTests.swift
@@ -87,6 +87,19 @@ struct SoloistEventTests {
         #expect(!SoloistEngine.startsAgain(status: .failed("key"), isRunning: true, networkReturned: true))
     }
 
+    /// Settings asks for the key until Soloist is set up and while it has failed, never while
+    /// the key works.
+    @MainActor
+    @Test func `a key that works is not asked for`() {
+        #expect(SoloistEngine.asksForKey(isSetUp: false, status: .off))
+        #expect(SoloistEngine.asksForKey(isSetUp: true, status: .failed(String(localized: "soloist.error.no_key"))))
+        #expect(SoloistEngine.asksForKey(isSetUp: true, status: .failed(String(localized: "soloist.error.keeps_stopping"))))
+
+        for status: SoloistEngine.Status in [.off, .installing, .starting, .waitingForPairing, .ready] {
+            #expect(!SoloistEngine.asksForKey(isSetUp: true, status: status))
+        }
+    }
+
     /// Soloist goes by this Mac's name, as Spotify's desktop app does, and the pairing hint names
     /// what to pick.
     @MainActor

diff --git a/Spotifly/Views/Components/SharedImage.swift b/Spotifly/Views/Components/SharedImage.swift
new file mode 100644
index 0000000..b8fff79
--- /dev/null
+++ b/Spotifly/Views/Components/SharedImage.swift
@@ -0,0 +1,146 @@
+//
+//  SharedImage.swift
+//  Spotifly
+//
+//  One image at one size, fetched and decoded once for everything that shows it.
+//
+
+import ImageIO
+import SwiftUI
+
+/// An image decoded at the size it is drawn, shared by every view showing it.
+///
+/// Not a cache: the registry holds it weakly, so it lives exactly as long as a view on screen
+/// holds it. The next to ask after that fetches it again, usually from the system's
+/// HTTP cache.
+@Observable
+final class SharedImage {
+    nonisolated struct Key: Hashable {
+        let url: URL
+        let pixels: Int
+
+        init(url: URL, points: CGFloat, scale: CGFloat) {
+            self.url = url
+            pixels = Int((points * scale).rounded(.up))
+        }
+    }
+
+    private final class Entry {
+        weak var image: SharedImage?
+
+        init(_ image: SharedImage) {
+            self.image = image
+        }
+    }
+
+    private static var shown: [Key: Entry] = [:]
+
+    /// The pauses before a failed image is asked for again, one per retry. Then it is left until
+    /// the network returns: one the CDN answers 404 for would fail every time.
+    static let retryPauses: [Duration] = [.seconds(5), .seconds(30), .seconds(180)]
+
+    let key: Key
+    private(set) var image: CGImage?
+    private(set) var failed = false
+    @ObservationIgnored private var load: Task<Void, Never>?
+    @ObservationIgnored private var answeredReturn = NetworkMonitor.shared.returns
+
+    /// The one already shown, if any.
+    static func existing(_ key: Key) -> SharedImage? {
+        shown[key]?.image
+    }
+
+    static func of(_ key: Key) -> SharedImage {
+        if let image = existing(key) {
+            return image
+        }
+        let image = SharedImage(key: key)
+        shown[key] = Entry(image)
+        return image
+    }
+
+    private init(key: Key) {
+        self.key = key
+    }
+
+    isolated deinit {
+        load?.cancel()
+        Self.forget(key)
+    }
+
+    /// Unless another has taken its place. A function of its own: Swift 6.4 crashes compiling a
+    /// deinit that reaches into the registry itself with code coverage on, as Xcode's tests build.
+    private static func forget(_ key: Key) {
+        if shown[key]?.image == nil {
+            shown[key] = nil
+        }
+    }
+
+    /// As `AsyncImage` gives it, which the views showing it switch over.
+    var phase: AsyncImagePhase {
+        if let image {
+            return .success(Image(decorative: image, scale: 1))
+        }
+        return failed ? .failure(URLError(.cannotDecodeContentData)) : .empty
+    }
+
+    func loadIfNeeded() {
+        if image == nil, load == nil {
+            start()
+        }
+    }
+
+    /// Asks again at once, once per return of the network however many views show it.
+    func networkReturned() {
+        let returns = NetworkMonitor.shared.returns
+        guard image == nil, returns != answeredReturn else { return }
+        answeredReturn = returns
+        load?.cancel()
+        start()
+    }
+
+    /// Holds itself weakly, so an image nobody shows any more is freed, and its load cancelled,
+    /// mid-request or mid-pause.
+    private func start() {
+        failed = false
+        load = Task { [weak self, key] in
+            for pause in [.zero] + Self.retryPauses {
+                if pause > .zero {
+                    guard (try? await Task.sleep(for: pause)) != nil else { return }
+                }
+                do {
+                    let image = try await Self.fetch(key)
+                    guard !Task.isCancelled, let self else { return }
+                    self.image = image
+                    self.load = nil
+                    return
+                } catch {
+                    guard !Task.isCancelled, let self else { return }
+                    // With no network at all it is still loading, and the network's return asks.
+                    if (error as? URLError)?.code == .notConnectedToInternet {
+                        self.load = nil
+                        return
+                    }
+                    self.failed = true
+                }
+            }
+            self?.load = nil
+        }
+    }
+
+    /// Off the main actor, at most `pixels` a side: a cover comes at up to 640, and a 32-point row
+    /// draws 64.
+    @concurrent nonisolated private static func fetch(_ key: Key) async throws -> CGImage {
+        let (data, _) = try await URLSession.shared.data(from: key.url)
+        let options: [CFString: Any] = [
+            kCGImageSourceCreateThumbnailFromImageAlways: true,
+            kCGImageSourceCreateThumbnailWithTransform: true,
+            kCGImageSourceShouldCacheImmediately: true,
+            kCGImageSourceThumbnailMaxPixelSize: key.pixels,
+        ]
+        guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+              let image = CGImageSourceCreateThumbnailAtIndex(source, 0, options as CFDictionary)
+        else { throw URLError(.cannotDecodeContentData) }
+        return image
+    }
+}
